{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "src",
        "outDir": "dist",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true
    },
    "include": ["src/**/*.ts"]
}
