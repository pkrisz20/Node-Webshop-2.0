<%#
    Error pages (views/errors/*.ejs).

    Sections: code    - HTTP status code
              message - optional text under the code
              actions - optional extra links
-%>
<!DOCTYPE html>
<html lang="<%= current_locale %>">
<head>
    <base href="<%= process.env.APP_URL %>" />
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, user-scalable=no" />
    <title><%= title %> | <%= process.env.SITE_NAME %></title>

    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#00a300" />
    <meta name="msapplication-TileColor" content="#00a300" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,500..600&amp;family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..600&amp;display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,500..600&amp;family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..600&amp;display=swap" />
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,500..600&amp;family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..600&amp;display=swap" />
    </noscript>

    <link rel="stylesheet" href="<%= getAssetPath('/css/main.css') %>" />
    <link rel="stylesheet" href="<%= getAssetPath('/css/error.css') %>" />
</head>

<body>
    <div class="site-wrap">
        <main class="error">
            <h1 class="error__title"><%= title %></h1>
            <h2 class="error__code"><%- yieldContent('code') %></h2>
            <%- yieldContent('message') %>
            <a href="<%= process.env.APP_URL %>/<%= current_locale %>" target="_self" class="error__link"><%= back_to_home %></a>
            <%- yieldContent('actions') %>
            <a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/<%- yieldContent('code') %>" target="_blank" class="error__link"><%= learn_more %></a>
        </main>
    </div>
</body>
</html>
