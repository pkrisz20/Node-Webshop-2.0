<% if (imageSrc) { %>
    <picture <%= locals.pictureClass ? "class='" + locals.pictureClass + "'" : '' %>>
        <% if (imageSrc) { %>
            <source
                srcset="<%= imageSrc.substring(0, imageSrc.lastIndexOf('.')) + '.webp' %>"
                type="image/webp"
            />
        <% } %>
        <img
            src="<%= imageSrc %>"
            alt="<%= locals.alt || '' %>"
            <%= locals.imgClass ? "class='" + locals.imgClass + "'" : '' %>
            loading="<%= locals.loading || 'lazy' %>"
        />
    </picture>
<% } else { %>
    <picture <%= locals.pictureClass ? "class='" + locals.pictureClass + "'" : '' %>>
        <source
            srcset="<%= getAssetPath('/images/no-picture.webp') %>"
            type="image/webp"
        />
        <img
            src="<%= getAssetPath('/images/no-picture.jpg') %>"
            alt="<%= locals.alt || '' %>"
            <%= locals.imgClass ? "class='" + locals.imgClass + "'" : '' %>
            loading="<%= locals.loading || 'eager' %>"
        />
    </picture>
<% } %>
