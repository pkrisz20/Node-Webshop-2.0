<% if (imageSrc && !locals.imageURL) { %>
    <picture class="<%= locals.pictureClass ? locals.pictureClass : '' %>">
        <% if (imageSrc) { %>
            <source
                srcset="<%= imageSrc.substring(0, imageSrc.lastIndexOf('.')) + '.webp' %>"
                type="image/webp"
            />
        <% } %>
        <img
            src="<%= imageSrc %>"
            alt="<%= locals.alt || '' %>"
            class="<%= locals.imgClass ? locals.imgClass : '' %>"
            loading="<%= locals.loading || 'lazy' %>"
            <% if (locals.imageWidth) {  %>
                width="<%= locals.imageWidth %>"
            <% } %>
            <% if (locals.imageHeight) {  %>
                height="<%= locals.imageHeight %>"
            <% } %>
            onerror="this.onerror = null;this.parentNode.children[0].srcset = this.src;"
        />
    </picture>
<% } else if (imageSrc && locals.imageURL) { %>
    <picture class="<%= locals.pictureClass ? locals.pictureClass : '' %>">
        <% if (webpImage) { %>
            <source
                srcset="<%= webpImage %>"
                type="image/webp"
            />
        <% } %>
        <img
            src="<%= imageSrc %>"
            alt="<%= locals.alt || '' %>"
            class="<%= locals.imgClass ? locals.imgClass : '' %>"
            loading="<%= locals.loading || 'lazy' %>"
            <% if (locals.imageWidth) {  %>
                width="<%= locals.imageWidth %>"
            <% } %>
            <% if (locals.imageHeight) {  %>
                height="<%= locals.imageHeight %>"
            <% } %>
            onerror="this.onerror = null;this.parentNode.children[0].srcset = this.src;"
        />
    </picture>
<% } else { %>
    <picture class="<%= locals.pictureClass ? locals.pictureClass : '' %>">
        <source
            srcset="<%= getAssetPath('/images/no-picture.webp') %>"
            type="image/webp"
        />
        <img
            src="<%= getAssetPath('/images/no-picture.jpg') %>"
            alt="<%= locals.alt || '' %>"
            class="<%= locals.imgClass ? locals.imgClass : '' %>"
            loading="<%= locals.loading || 'eager' %>"
        />
    </picture>
<% } %>
