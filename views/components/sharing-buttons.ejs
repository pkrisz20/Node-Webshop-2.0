<div class="sharing">
    <a
        class="sharing-button sharing-button--facebook"
        href="https://facebook.com/sharer/sharer.php?u=<%= process.env.APP_URL %>/<%= current_locale %>/<%= page_url %>"
        target="_blank"
        aria-label="<%= languageHandler('general.share_on_facebook', current_locale) %>"
        title="<%= languageHandler('general.share_on_facebook', current_locale) %>"
        onclick="window.open(this.href,'','scrollbars=yes,menubar=no,width=700,height=600,resizable=yes,toolbar=no,location=no,status=no'); return false;"
        rel="noopener"
    >
        <i class="fab fa-facebook"></i>
    </a>
    <a
        class="sharing-button sharing-button--twitter"
        href="https://twitter.com/intent/tweet/?text=<%= meta.title %>&amp;url=<%= process.env.APP_URL %>/<%= current_locale %>/<%= page_url %>"
        target="_blank"
        aria-label="<%= languageHandler('general.share_on_twitter', current_locale) %>"
        title="<%= languageHandler('general.share_on_twitter', current_locale) %>"
        onclick="window.open(this.href,'','scrollbars=yes,menubar=no,width=700,height=600,resizable=yes,toolbar=no,location=no,status=no'); return false;"
        rel="noopener"
    >
        <picture>
            <source srcset="<%= getAssetPath('/images/Twitter-X-White-Logo.webp') %>" type="image/webp" />
            <img src="<%= getAssetPath('/images/Twitter-X-White-Logo.png') %>" width="15" height="15" alt="Twitter X logo" />
        </picture>
    </a>
    <% if (mail_subject) { %>
        <a
            class="sharing-button sharing-button--email"
            href="mailto:?subject=<%= mail_subject %> | <%= process.env.SITE_NAME %> &amp;body=<%= process.env.APP_URL %>/<%= current_locale %>/<%= page_url %>"
            target="_self"
            title="<%= languageHandler('general.send_via_email', current_locale) %>"
            aria-label="<%= languageHandler('general.send_via_email', current_locale) %>"
            rel="noopener"
        >
            <i class="fas fa-envelope"></i>
        </a>
    <% } %>
    <button
        type="button"
        class="sharing-button sharing-button--clipboard"
        onclick="navigator.clipboard.writeText(window.location.href);"
        aria-label="<%= languageHandler('general.copy_to_clipboard', current_locale) %>"
        title="<%= languageHandler('general.copy_to_clipboard', current_locale) %>"
    >
        <i class="fas fa-link"></i>
    </button>
</div>
