<section class="gallery">
    <div class="wrapper">
        <%- include('./block-title.ejs', { title: languageHandler('general.gallery', current_locale), subtitle: languageHandler('general.gallery_subtitle', current_locale) }) %>
        <div class="gallery-list">
            <% images.forEach(item => { %>
                <% if (item.source) { %>
                    <figure class="gallery-list-card">

                        <%- include('./picture.ejs', { imageSrc: item.source, alt: item.name }) %>

                        <div class="overlay">
                            <figcaption class="overlay_content">
                                <div class="icons">
                                    <button
                                        type="button"
                                        onclick="navigator.clipboard.writeText('<%= process.env.APP_URL %>/<%= current_locale %>/gallery/<%= item.slug %>');"
                                        aria-label="<%= languageHandler('general.copy_to_clipboard', current_locale) %>"
                                        title="<%= languageHandler('general.copy_to_clipboard', current_locale) %>"
                                    >
                                        <i class="fas fa-link"></i>
                                    </button>
                                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= languageHandler("slugs.gallery", current_locale) %>/<%= item.slug %>/<%= item.id %>"><i class="far fa-eye"></i></a>
                                </div>
                                <% if (item.name) { %>
                                    <h3 class="hover_title"><%= item.name %></h3>
                                <% } %>
                            </figcaption>
                        </div>
                    </figure>
                <% } %>
            <% }) %>
        </div>
    </div>
    <div class="more">
        <a class="more-button" href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= languageHandler("slugs.galleries", current_locale) %>"><%= languageHandler("nav.watch_gallery", current_locale) %> <i class="far fa-angle-double-right"></i></a>
    </div>
</section>
