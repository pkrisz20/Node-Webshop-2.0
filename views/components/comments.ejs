<section class="comments">
    <div class="wrapper">

        <%- include('./block-title.ejs', { title: languageHandler('general.comments', current_locale), subtitle: languageHandler('general.comments_subtitle', current_locale) }) %>

        <div class="comments-information">
            <i class="fas fa-exclamation-triangle"></i>
            <p class="comments-information-text"><%= languageHandler('validations.accept_terms', current_locale) %></p>
            <p class="comments-information-text"><%= languageHandler('general.details_here', current_locale) %>: <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= staticContent['terms_of_use']['slug'] %>"><%= staticContent['terms_of_use']['title'] %></a></p>
        </div>

        <form class="form js-form-validate" method="post" data-url="<%= process.env.APP_URL %>/<%= current_locale %>/<%= articleType %>/comment/<%= itemId %>">
            <input
                id="recaptcha"
                value="<%= process.env.RECAPTCHA_SITE_KEY %>"
                name="recaptcha"
                type="hidden"
                class="g-recaptcha"
            />
            <div class="row">
                <div class="form-row">
                    <input
                        id="full-name"
                        data-rule-required="true"
                        name="fullName"
                        type="text"
                        placeholder="<%= languageHandler('validations.full_name', current_locale) %>"
                        class="form-control"
                    />
                    <label class="form-label" for="full-name">
                        <%= languageHandler('validations.full_name', current_locale) %>
                    </label>

                    <i class="error-icon fas fa-times" style="display: none;"></i>
                    <div class="form-row-error" style="display: none;"></div>
                </div>

                <div class="form-row">
                    <input
                        id="comment-email"
                        data-rule-required="true"
                        data-rule-email="true"
                        name="email"
                        type="email"
                        placeholder="<%= languageHandler('validations.email', current_locale) %>"
                        class="form-control"
                        autocomplete="off"
                    />
                    <label class="form-label" for="comment-email"><%= languageHandler('validations.email', current_locale) %></label>

                    <i class="error-icon fas fa-times" style="display: none;"></i>
                    <div class="form-row-error" style="display: none;"></div>
                </div>
            </div>

            <div class="form-row">
                <textarea
                    id="comment-message"
                    name="comment"
                    data-rule-required="true"
                    data-rule-max-length="1000"
                    placeholder="<%= languageHandler('general.comment', current_locale) %>"
                    class="form-control--textarea js-characters-count"
                    rows="10"
                    maxlength="1000"></textarea>
                <label
                    for="comment-message"
                    class="form-label form-textarea">
                    <%= languageHandler('general.comment', current_locale) %>
                </label>

                <i class="error-icon textarea-error fas fa-times" style="display: none;"></i>
                <div class="form-row-error" style="display: none;"></div>

                <small class="characters-count js-counter"><span>1000</span> / 1000</small>
            </div>

            <% if (articleType === 'product') { %>
                <div class="form-row">
                    <div class="rating js-ratings-option">
                        <input type="radio" id="star5" name="rating" value="5">
                        <label for="star5">&#9733;</label>
                        <input type="radio" id="star4" name="rating" value="4">
                        <label for="star4">&#9733;</label>
                        <input type="radio" id="star3" name="rating" value="3">
                        <label for="star3">&#9733;</label>
                        <input type="radio" id="star2" name="rating" value="2">
                        <label for="star2">&#9733;</label>
                        <input type="radio" id="star1" name="rating" value="1">
                        <label for="star1">&#9733;</label>
                    </div>
                </div>
            <% } %>

            <div class="form-row gdpr">
                <label
                    class="form-label"
                    for="data-handling">
                    <%= languageHandler('validations.accept_policy', current_locale) %>

                    <input
                        id="data-handling"
                        name="accept"
                        type="checkbox"
                        checked="checked"
                        class="form-row-checkbox"
                    />
                    <span class="checkmark"></span>
                </label>
                <span class="gdpr-details"><%= languageHandler('general.details_here', current_locale) %>: <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= staticContent['privacy_policy']['slug'] %>"><%= staticContent['privacy_policy']['title'] %></a></span>
            </div>

            <button type="submit" class="form-submit"><i class="fas fa-paper-plane"></i> <%= languageHandler('validations.send', current_locale) %></button>
        </form>

        <% if (articleComments.length > 0) { %>
            <div class="comments-container js-comments-container">
                <% articleComments.forEach(comment => { %>
                    <div class="comments-container-box">
                        <div class="content">
                            <div class="content__top">
                                <strong class="content__top-name"><%= comment.name %></strong>
                                <% if (comment.is_verified) { %>
                                    <span class="content__top-badge"><i class="fas fa-check-circle icon"></i><%= languageHandler('products.verified_purchase', current_locale) %></span>
                                <% } %>
                                <% if (comment.rating > 0) { %>
                                    <span class="content__top-rating">
                                        <% for (var index = 0; index < comment.rating; index++) { %>
                                            <i class="fas fa-star"></i>
                                        <% } %>
                                    </span>
                                <% } %>
                            </div>
                            <p class="content-comment"><%= comment.description %></p>
                            <time class="content-date"><i class="fas fa-history"></i> <%= comment.date %></time>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% if (showLoadMoreButton) { %>
                <button
                    type="button"
                    class="comments__load-more js-load-more-comments"
                    data-article="<%= itemId %>"
                    data-offset="1"
                    title="<%= languageHandler('products.load_more_comments', current_locale) %>"
                    aria-label="<%= languageHandler('products.load_more_comments', current_locale) %>"
                >
                    <i class="fas fa-plus-square"></i>
                    <%= languageHandler('products.load_more_comments', current_locale) %>
                </button>
            <% } %>

        <% } else if (articleComments.length == 0) { %>
            <div class="comments-information no-comment">
                <i class="fas fa-info-circle"></i>
                <p class="comments-information-text"><%= languageHandler('products.no_comment_yet', current_locale) %></p>
            </div>
        <% } %>
    </div>
</section>
