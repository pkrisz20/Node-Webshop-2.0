<section class="hero">
    <div class="hero-wrapper js-hero-slick">
        <% heros.forEach((data, index) => { %>
            <div class="slide">
                <div class="box">
                    <% if (index == 0) { %>
                        <h1 class="box-title"><%= data.text %></h1>
                    <% } else { %>
                        <h2 class="box-title"><%= data.text %></h2>
                    <% } %>

                    <% if (data.subText) { %>
                        <% if (index == 0) { %>
                            <h2 class="box-subtitle"><%= data.subText %></h2>
                        <% } else { %>
                            <h3 class="box-subtitle"><%= data.subText %></h3>
                        <% } %>
                    <% } %>
                    <% if (data.button) { %>
                        <a href="<%= data.link %>" target="<%= data.targetPage %>" class="box-btn"><%= data.button %></a>
                    <% } %>
                </div>
                <picture>
                    <source srcset="<%= data.image %>">
                    <img alt="<%= data.text %>" loading="lazy" src="images/no-picture.jpg">
                </picture>
            </div>
        <% }) %>
    </div>

    <% if (heros.length > 1) { %>
        <button type="button" class="slick-prev slick-arrow"><i class="fas fa-chevron-left"></i></button>
        <button type="button" class="slick-next slick-arrow"><i class="fas fa-chevron-right"></i></button>
    <% } %>
    <% if (heros.length > 1) { %>
        <div class="hero-dots"></div>
    <% } %>
</section>
