<div class="js-cookies cookie-consent-banner <%= gdprAcceptedCookies.length > 0 ? 'hidden' : '' %>">
    <div class="cookie-consent-banner__inner">
        <div class="cookie-consent-banner__copy">
            <strong class="cookie-consent-banner__header"><%= languageHandler('gdpr.cookie_title', current_locale) %></strong>
            <p class="cookie-consent-banner__description"><%= languageHandler('gdpr.cookie_desc', current_locale) %></p>
        </div>

        <div class="cookie-consent-banner__actions">
            <button
                data-show-text="<%= languageHandler('gdpr.details', current_locale) %>"
                data-hide-text="<%= languageHandler('gdpr.hide_details', current_locale) %>"
                type="button"
                class="cookie-consent-banner__cta cookie-consent-banner__cta--secondary js-toggle-cookie-details"
            >
                <span><%= languageHandler('gdpr.details', current_locale) %></span>
                <i class="fas fa-chevron-down"></i>
            </button>
            <button type="button" class="cookie-consent-banner__cta js-cookie-all js-cookie-submit"><%= languageHandler('gdpr.accept_all', current_locale) %></button>
        </div>

        <div style="display: none;" class="cookie-consent-banner__description cookie-consent-banner__description--long js-cookie-description">

            <div class="cookie__consent">

                <% if (gdprAcceptedCookies.length > 0) { %>
                    <% gdprCookies['types'].forEach(cookie_data => { %>
                        <% if (gdprAcceptedCookies.includes(cookie_data['type'])) { %>
                            <% cookie_data['checked'] = true; %>
                        <% } else { %>
                            <% cookie_data['checked'] = false; %>
                        <% } %>
                    <% }); %>
                <% } %>

                <% gdprCookies['types'].forEach(cookie_data => { %>
                    <div class="cookie__consent-item <%= cookie_data['disabled'] === true ? 'cookie__consent-item--disabled' : '' %>">
                        <input
                            type="checkbox"
                            name="allowed_cookies"
                            value="<%= cookie_data['type'] %>"
                            id="cookie-<%= cookie_data['type'] %>"
                            class="js-cookie-input"
                            <%= cookie_data['disabled'] === true ? disabled="disabled" : '' %>
                            <%= cookie_data['checked'] === true ? checked="checked" : '' %>
                        />
                        <label for="cookie-<%= cookie_data['type'] %>"><%= languageHandler("gdpr.cookie_" + cookie_data['type'], current_locale) %></label>
                    </div>
                <% }) %>

                <div class="cookie__consent--full-width">
                    <button type="button" class="cookie-consent-banner__cta js-cookie-submit"><%= languageHandler('gdpr.save_settings', current_locale) %></button>
                    <button type="button" class="cookie-consent-banner__cta cookie-consent-banner__cta--secondary js-reject js-cookie-submit"><%= languageHandler('gdpr.reject', current_locale) %></button>
                </div>
            </div>

            <div class="js-tabs">
                <header class="cookie__tabs-header">
                    <button
                        data-tab-link="#cookies-what-are-cookies"
                        class="cookie__tabs-link js-tab-link"
                    >
                        <%= languageHandler('gdpr.what_are_cookies', current_locale) %>
                    </button>
                    <% gdprCookies['types'].forEach(cookie_data => { %>
                        <button
                            data-tab-link="#cookies-<%= cookie_data['type'] %>"
                            class="cookie__tabs-link js-tab-link"
                        >
                            <%= languageHandler('gdpr.cookie_' + cookie_data['type'], current_locale) %>
                        </button>
                    <% }) %>
                </header>
                <div class="cookie__tabs-content js-tabs-content">
                    <div class="cookie__tabs-tab" id="cookies-what-are-cookies">
                        <%= languageHandler('gdpr.what_are_cookies_text', current_locale, gdprCookies['domain']) %>
                    </div>
                    <% gdprCookies['types'].forEach(cookie_data => { %>
                        <div class="cookie__tabs-tab" id="cookies-<%= cookie_data['type'] %>">
                            <%= languageHandler('gdpr.cookie_text_' + cookie_data['type'], current_locale) %>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>
