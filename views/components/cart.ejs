<div class="cart js-cart">
    <div class="cart-close js-cart-close"><i class="fas fa-times"></i></div>
    <h4 class="cart-title"><i class="fas fa-shopping-cart"></i> <%= languageHandler('orders.your_cart', current_locale) %></h4>

    <% if (cart.items.length > 0) { %>
        <h5 class="cart-counter"><%= languageHandler('orders.cart_count', current_locale) %>: <span class="js-cart-counter"><%= cart.totalCount %></span></h5>
        <div class="cart-container">
            <div class="cart-container-top">
                <a href="/<%= current_locale %>/order" aria-label="Navigation link to the orders page" class="cart-container-top_ordering"><%= ('orders.order', current_locale) %></>
                <strong class="cart-container-top_total"><%= languageHandler('orders.total_price', current_locale) %>: <span class="js-total-price"><%= cart.totalPrice %></span><small>RSD</small></strong>
            </div>

            <ul class="cart-container-list js-cart-list">
                <% cart.items.forEach(cartItem => { %>
                    <li class="cart-container-list-item">
                        <div class="cart-product">
                            <div class="cart-product-image">
                                <picture>
                                    <source srcset="<%= cartItem.image %>">
                                    <img class="cart-product-img" alt="<%= cartItem.productName %>" loading="lazy" src="images/no-picture.jpg">
                                </picture>
                            </div>

                            <div class="cart-product-desc">
                                <h5 class="cart-product-desc_name"><%= cartItem.productName %></h5>

                                <div class="quantities">
                                    <div class="quantities-container">
                                        <button type="button" class="quantities-btn minus"><i class="fas fa-minus"></i></button>
                                        <%# setAmountQuantity(cartItem.productId, cartItem.maxQuantity, $event) %>
                                        <%#  @keypress="isDigit($event)" %>
                                        <input class="quantities-input" type="number" value="<%= cartItem.quantity %>" min="1" max="<%= cartItem.maxQuantity %>" />
                                        <button type="button" class="quantities-btn plus"><i class="fas fa-plus"></i></button>
                                    </div>

                                    <small class="quantities-price"><i class="fas fa-times"></i> <span><%= cartItem.price %> RSD</span></small>
                                </div>

                                <div class="functions">
                                    <a href="/<%= current_locale %>/product" class="functions_details" aria-label="Link to product details"><i class="fas fa-info-circle"></i></a>
                                    <button type="button" value="<%= languageHandler('general.remove', current_locale) %>" class="functions_remove"><i class="fas fa-times"></i></button>
                                </div>
                            </div>
                        </div>
                    </li>
                <% }) %>
            </ul>
        </div>

    <% } else if (cart.items.length == 0) { %>
        <h5 class="cart-empty js-cart-empty"><i class="fas fa-exclamation-circle"></i> <%= languageHandler('orders.cart_empty', current_locale) %></h5>
    <% } %>
</div>
