<aside class="cart js-cart" aria-label="<%= languageHandler('orders.your_cart', current_locale) %>">
    <div class="cart-header">
        <h4 class="cart-title"><i class="fas fa-shopping-bag"></i> <%= languageHandler('orders.your_cart', current_locale) %></h4>
        <button type="button" class="cart-close js-cart-close" aria-label="<%= languageHandler('general.remove', current_locale) %>"><i class="fas fa-times"></i></button>
    </div>

    <% if (cart.items.length > 0) { %>
        <h5 class="cart-counter"><%= languageHandler('orders.cart_count', current_locale) %>: <span class="js-cart-counter"><%= cart.totalCount %></span></h5>
        <div class="cart-container">
            <div class="cart-container-top">
                <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= languageHandler("slugs.cart", current_locale) %>" aria-label="Navigation link to the orders page" class="cart-container-top_ordering"><%= languageHandler('orders.order', current_locale) %></a>
                <strong class="cart-container-top_total"><%= languageHandler('orders.total_price', current_locale) %>: <span class="js-total-price"><%= cart.totalPrice %></span><small><%= currency %></small></strong>
            </div>

            <ul class="cart-container-list js-cart-list">
                <% cart.items.forEach(cartItem => { %>
                    <li class="cart-container-list-item js-cart-item">
                        <div class="cart-product">
                            <div class="cart-product-image">
                                <%- include('../components/picture.ejs', {
                                    imgClass: "cart-product-img",
                                    imageSrc: cartItem.image,
                                    alt: cartItem.productName
                                }) %>
                            </div>

                            <div class="cart-product-desc">
                                <strong class="cart-product-desc_name"><%= cartItem.productName %></strong>

                                <div class="quantities">
                                    <div class="quantities-container js-quantities">
                                        <button type="button" class="quantities-btn js-quantity-btn minus"><i class="fas fa-minus"></i></button>
                                        <input class="quantities-input js-product-quantity" data-id="<%= cartItem.productId %>" type="number" value="<%= cartItem.quantity %>" min="1" max="<%= cartItem.maxQuantity %>" />
                                        <button type="button" class="quantities-btn js-quantity-btn plus"><i class="fas fa-plus"></i></button>
                                    </div>

                                    <small class="quantities-price"><i class="fas fa-times"></i> <span><%= cartItem.price %> <%= currency %></span></small>
                                </div>

                                <div class="functions">
                                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= languageHandler("slugs.product", current_locale) %>/<%= cartItem.slug %>/<%= cartItem.productId %>" class="functions_details" aria-label="Link to product details"><i class="fas fa-info-circle"></i></a>
                                    <button type="button" value="<%= languageHandler('general.remove', current_locale) %>" data-id="<%= cartItem.productId %>" class="functions_remove js-remove-cart"><i class="fas fa-times"></i></button>
                                </div>
                            </div>
                        </div>
                    </li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <div class="cart-empty js-cart-empty <%= cart.items.length > 0 ? 'hide' : 'show'%>">
        <div class="cart-empty__inner">
            <span class="cart-empty__icon"><i class="fas fa-shopping-basket"></i></span>
            <p class="cart-empty__text"><%= languageHandler('orders.cart_empty', current_locale) %></p>
            <a class="cart-empty__link" href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= languageHandler("slugs.products", current_locale) %>"><%= languageHandler('products.all_products', current_locale) %> <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</aside>
