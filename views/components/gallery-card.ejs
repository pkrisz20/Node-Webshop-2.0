<a class="gallery-card" href="/<%= current_locale %>/gallery">
    <time class="gallery-card-date"><%= galleryItem.date %></time>
    <figure class="gallery-card-image">
        <picture>
            <source srcset="<%= galleryItem.thumbnailImage %>">
            <img loading="lazy" src="/images/no-picture.jpg" />
        </picture>
        <div class="icon">
            <i class="far fa-eye"></i>
        </div>
        <figcaption class="caption">
            <% if (galleryItem.name) { %>
                <strong class="caption-name"><%= galleryItem.name %></strong>
            <% } %>

            <% if (galleryItem.category) { %>
                <div class="caption-category"><span>|</span><%= galleryItem.category %><span>|</span></div>
            <% } %>
        </figcaption>
    </figure>
</a>
