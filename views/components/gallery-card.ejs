<a class="gallery-card" href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= languageHandler("slugs.gallery", current_locale) %>/<%= galleryItem.slug %>/<%= galleryItem.id %>">
    <time class="gallery-card-date"><%= galleryItem.date %></time>
    <figure class="gallery-card-image">

        <%- include('./picture.ejs', { imageSrc: galleryItem.thumbnailImage, alt: galleryItem.name }) %>

        <div class="icon">
            <i class="far fa-eye"></i>
        </div>
        <figcaption class="caption">
            <% if (galleryItem.name) { %>
                <strong class="caption-name"><%= galleryItem.name %></strong>
            <% } %>
        </figcaption>
    </figure>
</a>
