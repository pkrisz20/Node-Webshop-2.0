<section class="featured-blogs">
    <div class="wrapper">
        <%- include('./block-title.ejs', { title: languageHandler('general.blog', current_locale), subtitle: languageHandler('general.blog_subtitle', current_locale) }) %>

        <div class="js-featured-blogs">
            <% blogs.forEach(item => { %>
                <div class="slide">
                    <%- include("./blog-card.ejs", { blog: item }) %>
                </div>
            <% }) %>
        </div>

        <% if (blogs.length > 1) { %>
            <button
                type="button"
                class="slick-prev slick-arrow"
                aria-label="<%= languageHandler('general.prev_page', current_locale) %>"
                title="<%= languageHandler('general.prev_page', current_locale) %>"
            >
                <i class="fas fa-chevron-left"></i>
            </button>
            <button
                type="button"
                class="slick-next slick-arrow"
                aria-label="<%= languageHandler('general.next_page', current_locale) %>"
                title="<%= languageHandler('general.next_page', current_locale) %>"
            >
                <i class="fas fa-chevron-right"></i>
            </button>
        <% } %>
    </div>
</section>
