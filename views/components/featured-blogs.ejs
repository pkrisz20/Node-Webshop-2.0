<section class="featured-blogs">
    <div class="wrapper">
        <div class="section-head">
            <%- include('./block-title.ejs', { title: locals.blockTitle || languageHandler('general.blog', current_locale), subtitle: locals.blockTitle ? null : languageHandler('general.blog_subtitle', current_locale) }) %>

            <% if (blogs.length > 1) { %>
                <div class="section-head__arrows">
                    <button
                        type="button"
                        class="slick-prev slick-arrow"
                        aria-label="<%= languageHandler('general.prev_page', current_locale) %>"
                        title="<%= languageHandler('general.prev_page', current_locale) %>"
                    >
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <button
                        type="button"
                        class="slick-next slick-arrow"
                        aria-label="<%= languageHandler('general.next_page', current_locale) %>"
                        title="<%= languageHandler('general.next_page', current_locale) %>"
                    >
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            <% } %>
        </div>

        <div class="js-featured-blogs">
            <% blogs.forEach(item => { %>
                <div class="slide">
                    <%- include("./blog-card.ejs", { blog: item }) %>
                </div>
            <% }) %>
        </div>
    </div>
</section>
