<!DOCTYPE html>
<html lang="<%= current_locale %>">
    <%- include('layout/head.ejs') %>

    <link rel="preload" href="css/plugins/slick.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" href="css/home.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('layout/header.ejs') %>

        <%- include('components/cart.ejs') %>

        <main class="home">
            <%- include('components/hero.ejs') %>

            <%- include('components/categories.ejs') %>

            <%- include('components/featured-products.ejs') %>

            <% if (products.length > 0) { %>
                <div class="more">
                    <a class="more-button" href="<%= process.env.APP_URL %>/<%= current_locale %>/products"><%= languageHandler("products.all_products", current_locale) %> <i class="far fa-angle-double-right"></i></a>
                </div>
            <% } %>

            <section class="bg">
                <div class="bg-box">
                    <h2 class="bg-box--title">We love the animals</h2>
                    <p class="bg-box--subtitle">Smooth reliable, responsive rebgy, perfect portfolio, unique blog layout and many many options for you</p>
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/about" aria-label="Link to about us page" target="_self" class="bg-box_btn"><%= languageHandler("nav.about", current_locale) %></a>
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/gallery" aria-label="Link to gallery list page" target="_self" class="bg-box_btn bg-btn"><%= languageHandler("nav.gallery", current_locale) %></a>
                </div>
            </section>

            <section class="countup js-countup-section">
                <div class="wrapper">
                    <div class="countup__item">
                        <i class="fas fa-users countup__item-icon"></i>
                        <div class="countup__item-number js-countup-item" data-number="<%= DB_CONFIG["satisfied_clients_number"] %>">0</div>
                        <span class="countup__item-title"><%= languageHandler("counter.satisfied_clients", current_locale) %></strong>
                    </div>

                    <div class="countup__item">
                        <i class="fas fa-mug-hot countup__item-icon"></i>
                        <div class="countup__item-number js-countup-item" data-number="<%= DB_CONFIG["cups_of_coffe_number"] %>">0</div>
                        <span class="countup__item-title"><%= languageHandler("counter.cups_coffe", current_locale) %></strong>
                    </div>

                    <div class="countup__item">
                        <i class="far fa-chart-bar countup__item-icon"></i>
                        <div class="countup__item-number js-countup-item" data-number="<%= DB_CONFIG["animals_in_numbers"] %></div>">0</div>
                        <span class="countup__item-title"><%= languageHandler("counter.animals", current_locale) %></strong>
                    </div>

                    <div class="countup__item">
                        <i class="fas fa-shipping-fast countup__item-icon"></i>
                        <div class="countup__item-number js-countup-item" data-number="<%= DB_CONFIG["posted_products_number"] %></div>">0</div>
                        <span class="countup__item-title"><%= languageHandler("counter.posted_products", current_locale) %></strong>
                    </div>
                </div>
            </section>

            <% if (galleries.length > 0) { %>
                <%- include('components/featured-gallery.ejs', { images: galleries }) %>
            <% } %>

            <% if (blogs.length > 0) { %>
                <%- include('components/featured-blogs.ejs', { blogs: blogs }) %>
            <% } %>

            <% if (blogs.length > 0) { %>
                <div class="more">
                    <a class="more-button" href="<%= process.env.APP_URL %>/<%= current_locale %>/blogs"><%= languageHandler("nav.visit_blog", current_locale) %> <i class="far fa-angle-double-right"></i></a>
                </div>
            <% } %>
        </main>

        <%- include('layout/footer.ejs') %>
    </div>

    <script type="text/javascript">
        var locale = <%- JSON.stringify(current_locale) %>;
    </script>
    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/slick.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <script type="text/javascript" src="js/plugins/waypoints.min.js"></script>
    <script type="text/javascript" src="js/plugins/countup.min.js"></script>
    <script type="text/javascript" src="js/main.js"></script>
</body>
</html>
