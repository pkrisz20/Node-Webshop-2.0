<%- extend('layouts/admin') %>

<%- section('content') %>
    <main>
        <div class="container-fluid px-4">
            <h1 class="mt-4">Gyakori kérdések</h1>

            <% if (FAQList.length > 0) { %>
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="fs-5">
                            <i class="fas fa-table me-1"></i>
                            Gyakori kérdések
                        </div>

                        <a class="btn btn-primary" target="_self" href="<%= process.env.APP_URL %>/admin/faq/new">
                            <i class="fas fa-plus-circle"></i>
                            Új kérdés/válasz
                        </a>
                    </div>

                    <div class="card-body table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">Kérdés</th>
                                    <th scope="col">Látható</th>
                                    <th scope="col">Dátum (utoljára módosítva)</th>
                                    <th scope="col">Műveletek</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% FAQList.forEach(item => { %>
                                    <tr>
                                        <td><%= item.question %></td>
                                        <td><%- item.is_active %></td>
                                        <td><%= item.date %></td>
                                        <td>
                                            <i data-url="<%= process.env.APP_URL %>/admin/faq/delete/<%= item.id %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                            <a class="link-dark mx-1" href="<%= process.env.APP_URL %>/admin/faq/edit/<%= item.id %>">
                                                <i role=button class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
    </main>
<%- endSection() %>
