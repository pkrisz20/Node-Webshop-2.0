<!DOCTYPE html>
<html lang="hu">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="<%= getAssetPath('/css/login.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <main class="login">
            <div class="wrapper">
                <h1 class="main-title">Adminisztráció</h1>

                <form class="form js-form-validate" method="post" data-url="<%= process.env.APP_URL %>/admin/login">
                    <div class="form-row">
                        <input
                            id="admin_username"
                            name="admin_username"
                            type="text"
                            data-rule-required="true"
                            placeholder="Felhasználónév"
                            class="form-control"
                        />
                        <label for="admin_username" class="form-label">Felhasználónév</label>

                        <i class="error-icon fas fa-times" style="display: none;"></i>
                        <div class="form-row-error" style="display: none;"></div>
                    </div>
                    <div class="form-row">
                        <span class="form-eye js-password-toggle">
                            <i class="fas fa-eye"></i>
                            <i class="fas fa-eye-slash"></i>
                        </span>
                        <input
                            id="admin_password"
                            name="admin_password"
                            autocomplete="off"
                            type="password"
                            data-rule-required="true"
                            placeholder="Jelszó"
                            class="form-control"
                        />
                        <label for="admin_password" class="form-label">Jelszó</label>

                        <i class="error-icon fas fa-times" style="display: none;"></i>
                        <div class="form-row-error" style="display: none;"></div>
                    </div>
                    <button type="submit" class="form-submit"><i class="fas fa-sign-in-alt"></i> Belépés</button>
                </form>
            </div>
        </main>
    </div>

    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/validate.min.js') %>"></script>

    <% if (current_locale != 'en') { %>
        <script type="text/javascript" src='<%= getAssetPath("/js/plugins/validator_messages_" + current_locale + ".js") %>'></script>
    <% } %>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jconfirm.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/main.js') %>"></script>
</body>
</html>
