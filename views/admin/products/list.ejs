<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Termékek</h1>

                        <% if (webshopProducts.length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div class="fs-5">
                                        <i class="fas fa-table me-1"></i>
                                        Termékek
                                    </div>
                                    <a class="btn btn-primary" target="_self" href="<%= process.env.APP_URL %>/admin/products/new">
                                        <i class="fas fa-plus-circle"></i>
                                        Új termék
                                    </a>
                                </div>
                                <div class="card-body table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th scope="col">Termék neve</th>
                                                <th scope="col">Látható</th>
                                                <th scope="col">Kedvezmény</th>
                                                <th scope="col">Kategória</th>
                                                <th scope="col">Dátum (utoljára módosítva)</th>
                                                <th scope="col">Műveletek</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% webshopProducts.forEach(product => { %>
                                                <tr>
                                                    <td><%= product.productName %></td>
                                                    <td><%- product.is_active %></td>
                                                    <td><%- product.isOnDiscount %></td>
                                                    <td><%= product.productCategory %></td>
                                                    <td><%= product.date %></td>
                                                    <td>
                                                        <i data-url="<%= process.env.APP_URL %>/admin/product/delete/<%= product.productId %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                        <a class="mx-1 link-dark" href="<%= process.env.APP_URL %>/admin/products/edit/<%= product.productId %>">
                                                            <i role=button class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>

                        <% if (pageCount > 1) { %>
                            <%- include('../layout/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, paginationLink: paginationLink }) %>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/bootstrap.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/chart.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/sweetalert.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/admin.js') %>"></script>
    </body>
</html>
