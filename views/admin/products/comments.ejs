<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Hozzászólások</h1>

                        <ul class="nav nav-pills mb-3" role="tablist">
                            <li class="nav-item mx-2">
                                <a class="nav-link" data-bs-toggle="pill" href="#new-comments">Új hozzászólások</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="pill" href="#active-comments">Aktív hozzászólások</a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane fade" id="new-comments">
                                <% if (newComments.length > 0) { %>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <i class="fas fa-table me-1"></i>
                                            Új Hozzászólások
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-striped table-hover">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th scope="col">Név</th>
                                                        <th scope="col">Email</th>
                                                        <th scope="col">Látható</th>
                                                        <th scope="col">Termék</th>
                                                        <th scope="col">Megírták ekkor</th>
                                                        <th scope="col">Műveletek</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% newComments.forEach(comment => { %>
                                                        <tr>
                                                            <td><%= comment.author_name %></td>
                                                            <td><%- comment.email %></td>
                                                            <td><%- comment.isActive %></td>
                                                            <td><%= comment.productName %></td>
                                                            <td><%= comment.date %></td>
                                                            <td>
                                                                <i data-url="<%= process.env.APP_URL %>/admin/product/comments/delete/<%= comment.comment_id %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                                <a
                                                                    class="link-dark mx-1"
                                                                    target="_blank"
                                                                    href="<%= process.env.APP_URL %>/hu/products/<%= comment.product_slug %>"
                                                                >
                                                                    <i class="fas fa-external-link-alt"></i>
                                                                </a>
                                                                <i class="far fa-comment-dots link-primary jquery-tooltip" title="<%= comment.comment_text %>"></i>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                            <div class="tab-pane show fade active" id="active-comments">
                                <% if (activeComments.length > 0) { %>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <i class="fas fa-table me-1"></i>
                                            Aktív hozzászólások
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-striped table-hover">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th scope="col">Név</th>
                                                        <th scope="col">Email</th>
                                                        <th scope="col">Látható</th>
                                                        <th scope="col">Termék</th>
                                                        <th scope="col">Megírták ekkor</th>
                                                        <th scope="col">Műveletek</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% activeComments.forEach(comment => { %>
                                                        <tr title="<%= comment.comment_text %>">
                                                            <td><%= comment.author_name %></td>
                                                            <td><%- comment.email %></td>
                                                            <td><%- comment.isActive %></td>
                                                            <td><%= comment.productName %></td>
                                                            <td><%= comment.date %></td>
                                                            <td>
                                                                <i data-url="<%= process.env.APP_URL %>/admin/product/comments/delete/<%= comment.comment_id %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                                <a
                                                                    class="link-dark mx-1"
                                                                    target="_blank"
                                                                    href="<%= process.env.APP_URL %>/hu/products/<%= comment.product_slug %>"
                                                                >
                                                                    <i class="fas fa-external-link-alt"></i>
                                                                </a>
                                                                <i class="far fa-comment-dots link-primary jquery-tooltip" title="<%= comment.comment_text %>"></i>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <% if (pageCount > 1) { %>
                            <%- include('../layout/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, paginationLink: paginationLink }) %>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="js/plugins/jquery.min.js"></script>
        <script src="admin/js/plugins/bootstrap.min.js"></script>
        <script src="admin/js/plugins/chart.min.js"></script>
        <script src="admin/js/plugins/sweetalert.min.js"></script>
        <script src="admin/js/plugins/tooltipster.min.js"></script>
        <script src="admin/js/admin.js"></script>
    </body>
</html>
