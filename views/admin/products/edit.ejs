<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main class="p-4">
                    <h1 class="h3 mb-3">Termék szerkesztése</h1>

                    <ul class="nav nav-pills mb-3 p-3 border border-primary bg-dark bg-opacity-25 rounded-3" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold active" data-bs-toggle="pill" href="#HU">Általános adatok + <img src="images/flag-hu.png" width="20" height="15" alt="Magyar" /> Magyar</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#SR"><img src="images/flag-sr.png" width="20" height="15" alt="Szerb" /> Szerb</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#EN"><img src="images/flag-en.png" width="20" height="15" alt="Angol" /> Angol</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#media-thumbnail"><i class="fas fa-photo-video"></i> Indexkép</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#media"><i class="fas fa-photo-video"></i> Média</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <form class="row js-validate-form" method="post" data-url="<%= process.env.APP_URL %>/admin/products/edit/handle/<%= formValues.id %>">

                            <div class="tab-pane show fade active" id="HU">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-name-hu" class="form-label">Termek megnevezése</label>
                                            <input type="text" data-rule-required="true" id="product-name-hu" class="form-control" name="name[hu]" value="<%= formValues.hu.name %>" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label class="form-label" for="product-category">Kategória</label>
                                            <select class="form-select" data-rule-required="true" name="category_id" id="product-category">
                                                <% if (webshopCategories.length > 0) { %>

                                                    <% webshopCategories.forEach(category => { %>
                                                        <option value="<%= category.id %>" <%= category.id == formValues.category_id ?  'selected' : '' %> ><%= category.name %></option>
                                                    <% }) %>

                                                <% } else { %>
                                                    <option value="" selected>Nincs feltöltve még kategória...</option>
                                                <% } %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-short-hu" class="form-label">Rövid leírás</label>
                                            <textarea id="product-short-hu" rows="5" name="short_description[hu]" class="form-control"><%= formValues.hu.short_description ? formValues.hu.short_description : '' %></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-6 js-price-wrapper">
                                        <div class="form-row">
                                            <label for="product-price" class="form-label">Árjegyzék</label>
                                            <div class="input-group mb-2">
                                                <span class="input-group-text">RSD</span>
                                                <input type="text" data-rule-required="true" data-rule-digits="true" name="price" value="<%= formValues.price %>" id="product-price" class="form-control" />
                                                <span class="input-group-text">.00</span>
                                            </div>
                                        </div>

                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input js-discount-input-toggle" type="checkbox" <%= formValues.discount_value ? 'checked' : '' %> id="discount-price" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="discount-price">Akciós ár</label>
                                        </div>
                                        <div class="form-row js-input-container" style="<%= !formValues.discount_value ? 'display: none;' : '' %>">
                                            <div class="input-group">
                                                <span class="input-group-text">RSD</span>
                                                <input type="text" name="discount_value" value="<%= formValues.discount_value ? formValues.discount_value : '' %>" class="form-control js-discount-input" />
                                                <span class="input-group-text">.00</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" <%= formValues.is_active === 1 ? 'checked' : '' %> value="<%= formValues.is_active %>" name="is_active" id="product-is-active" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="product-is-active">Aktív</label>
                                        </div>
                                        <div class="form-check form-switch ms-sm-2 d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" <%= formValues.is_featured === 1 ? 'checked' : '' %> value="<%= formValues.is_featured %>" name="is_featured" id="product-is-featured" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="product-is-featured">Főoldali kiemelés</label>
                                        </div>
                                        <div class="form-check form-switch ms-sm-2 d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" <%= formValues.is_available === 1 ? 'checked' : '' %> value="<%= formValues.is_available %>" name="is_available" id="product-is-orderable" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="product-is-orderable">Rendelhető</label>
                                        </div>
                                        <div class="form-check form-switch ms-sm-2 d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" <%= formValues.is_new === 1 ? 'checked' : '' %> value="<%= formValues.is_new %>" name="is_new" id="product-is-new" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="product-is-new">Új</label>
                                        </div>
                                        <div>
                                            <div class="form-check form-switch d-inline-block">
                                                <input class="form-check-input js-boolean-checkbox" type="checkbox" <%= formValues.is_delivered === 1 ? 'checked' : '' %> value="<%= formValues.is_delivered %>" name="is_delivered" id="product-is-delivered" role="switch" />
                                                <label class="form-check-label ms-sm-2 lh-lg" for="product-is-delivered">Szállítható</label>
                                            </div>
                                            <div class="form-check form-switch ms-sm-2 d-inline-block">
                                                <input class="form-check-input js-boolean-checkbox" type="checkbox" <%= formValues.is_allowed === 1 ? 'checked' : '' %> value="<%= formValues.is_allowed %>" name="comments_allowed" id="product-comments-allowed" role="switch" />
                                                <label class="form-check-label ms-sm-2 lh-lg" for="product-comments-allowed">Hozzászólások engedélyezése</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-max-order" class="form-label">Maximális rendelhető mennyiség</label>
                                            <input type="text" name="max_order_count" id="product-max-order" data-rule-required="true" data-rule-digits="true" class="form-control" value="<%= formValues.max_order_count %>" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="product-long-hu" class="form-label">Hosszú leírás</label>
                                    <textarea id="product-long-hu" name="product_description[hu]" class="form-control js-ckeditor"><%= formValues.hu.description ? formValues.hu.description : '' %></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-primary" type="submit">Mentés</button>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="SR">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-name-sr" class="form-label">Termék megnevezése szerbül</label>
                                            <input type="text" data-rule-required="true" id="product-name-sr" class="form-control" name="name[sr]" value="<%= formValues.sr.name %>" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-short-sr" class="form-label">Rövid leírás szerbül</label>
                                            <textarea id="product-short-sr" rows="5" name="short_description[sr]" class="form-control"><%= formValues.sr.short_description ? formValues.sr.short_description : '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="product-long-sr" class="form-label">Hosszú leírás szerbül</label>
                                    <textarea id="product-long-sr" name="product_description[sr]" class="form-control js-ckeditor"><%= formValues.sr.description ? formValues.sr.description : '' %></textarea>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="EN">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-name-en" class="form-label">Termék megnevezése angolul</label>
                                            <input type="text" data-rule-required="true" id="product-name-en" class="form-control" name="name[en]" value="<%= formValues.en.name %>" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="product-short-en" class="form-label">Rövid leírás angolul</label>
                                            <textarea id="product-short-en" rows="5" name="short_description[en]" class="form-control"><%= formValues.en.short_description ? formValues.en.short_description : '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="product-long-en" class="form-label">Hosszú leírás angolul</label>
                                    <textarea id="product-long-en" name="product_description[en]" class="form-control js-ckeditor"><%= formValues.en.description ? formValues.en.description : '' %></textarea>
                                </div>
                            </div>
                        </form>

                        <div class="tab-pane fade" id="media-thumbnail">
                            <%- include('../components/image-uploader.ejs', { single: true, whereToUpload: "products", databaseID: formValues.id, uploadedImages: formValues.image_thumbnail }) %>
                        </div>

                        <div class="tab-pane fade" id="media">
                            <%- include('../components/image-uploader.ejs', { multiple: true, whereToUpload: "products", databaseID: formValues.id, uploadedImages: formValues.images }) %>
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/bootstrap.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/chart.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/sweetalert.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/ckeditor.min.js') %>"></script>
        <script src="<%= getAssetPath('/js/plugins/validate.min.js') %>"></script>
        <script src="<%= getAssetPath('/js/plugins/validator_messages_hu.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/admin.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/image-uploader.js') %>"></script>
    </body>
</html>
