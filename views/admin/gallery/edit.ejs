<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main class="p-4">
                    <h1 class="h3 mb-3">Galléria szerkesztése</h1>

                    <ul class="nav nav-pills mb-3 p-3 border border-primary bg-dark bg-opacity-25 rounded-3" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold active" data-bs-toggle="pill" href="#HU">Általános adatok + <img src="images/flag-hu.png" width="20" height="15" alt="Magyar" /> Magyar</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#SR"><img src="images/flag-sr.png" width="20" height="15" alt="Szerb" /> Szerb</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#EN"><img src="images/flag-en.png" width="20" height="15" alt="Angol" /> Angol</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#media-thumbnail"><i class="fas fa-photo-video"></i> Indexkép</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#media"><i class="fas fa-photo-video"></i> Média</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <form class="row js-validate-form" method="post" data-url="<%= process.env.APP_URL %>/admin/gallery/edit/handle/<%= formValues.id %>">

                            <div class="tab-pane show fade active" id="HU">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="gallery-name-hu" class="form-label">Galléria neve</label>
                                            <input type="text" data-rule-required="true" id="gallery-name-hu" class="form-control" name="name[hu]" value="<%= formValues.hu.name %>" />
                                        </div>
                                        <div class="form-row">
                                            <label for="gallery-date" class="form-label">Galléria dátuma</label>
                                            <input type="date" data-rule-required="true" id="gallery-date" class="form-control" name="date" value="<%= formValues.date %>" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="gallery-short-hu" class="form-label">Rövid leírás</label>
                                            <textarea id="gallery-short-hu" rows="5" name="description[hu]" class="form-control"><%= formValues.hu.description %></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" name="is_active" <%= formValues.is_active === 1 ? 'checked' : '' %> value="<%= formValues.is_active %>" id="gallery-is-active" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="gallery-is-active">Aktív</label>
                                        </div>
                                        <div class="form-check form-switch ms-sm-2 d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" <%= formValues.is_featured === 1 ? 'checked' : '' %> value="<%= formValues.is_featured %>" type="checkbox" name="is_featured" id="gallery-is-featured" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="gallery-is-featured">Főoldali kiemelés</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="SR">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="gallery-name-sr" class="form-label">Galléria neve szerbül</label>
                                            <input type="text" data-rule-required="true" id="gallery-name-sr" class="form-control" name="name[sr]" value="<%= formValues.sr.name %>" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="gallery-short-sr" class="form-label">Rövid leírás szerbül</label>
                                            <textarea id="gallery-short-sr" rows="5" name="description[sr]" class="form-control"><%= formValues.sr.description %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="EN">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="gallery-name-en" class="form-label">Galléria neve angolul</label>
                                            <input type="text" data-rule-required="true" id="gallery-name-en" class="form-control" name="name[en]" value="<%= formValues.en.name %>" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="gallery-short-en" class="form-label">Rövid leírás angolul</label>
                                            <textarea id="gallery-short-en" rows="5" name="description[en]" class="form-control"><%= formValues.en.description %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button class="btn btn-primary" type="submit">Mentés</button>
                            </div>
                        </form>

                        <div class="tab-pane fade" id="media-thumbnail">
                            <%- include('../components/image-uploader.ejs', { single: true, whereToUpload: "galleries", databaseID: formValues.id, uploadedImages: formValues.thumbnail }) %>
                        </div>

                        <div class="tab-pane fade" id="media">
                            <%- include('../components/image-uploader.ejs', { multiple: true, whereToUpload: "galleries", databaseID: formValues.id, uploadedImages: formValues.images }) %>
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/bootstrap.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/chart.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/sweetalert.min.js') %>"></script>
        <script src="<%= getAssetPath('/js/plugins/validate.min.js') %>"></script>
        <script src="<%= getAssetPath('/js/plugins/validator_messages_hu.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/admin.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/image-uploader.js') %>"></script>
    </body>
</html>
