<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Gallériák</h1>

                        <% if (galleriesList.length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div class="fs-5">
                                        <i class="fas fa-table me-1"></i>
                                        Gallériák
                                    </div>

                                    <a class="btn btn-primary" target="_self" href="<%= process.env.APP_URL %>/admin/gallery/new">
                                        <i class="fas fa-plus-circle"></i>
                                        Új galléria
                                    </a>
                                </div>

                                <div class="card-body table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th scope="col">Galléria neve</th>
                                                <th scope="col">Látható</th>
                                                <th scope="col">Dátum (utoljára módosítva)</th>
                                                <th scope="col">Műveletek</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% galleriesList.forEach(gallery => { %>
                                                <tr>
                                                    <td><%= gallery.galleryName %></td>
                                                    <td><%- gallery.is_active %></td>
                                                    <td><%= gallery.date %></td>
                                                    <td>
                                                        <i data-url="<%= process.env.APP_URL %>/admin/gallery/delete/<%= gallery.galleryId %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                        <a class="link-dark mx-1" href="<%= process.env.APP_URL %>/admin/gallery/edit/<%= gallery.galleryId %>">
                                                            <i role=button class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>

                        <% if (pageCount > 1) { %>
                            <%- include('../layout/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, paginationLink: paginationLink }) %>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="js/plugins/jquery.min.js"></script>
        <script src="admin/js/plugins/bootstrap.min.js"></script>
        <script src="admin/js/plugins/chart.min.js"></script>
        <script src="admin/js/plugins/sweetalert.min.js"></script>
        <script src="admin/js/admin.js"></script>
    </body>
</html>
