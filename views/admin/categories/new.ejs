<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main class="p-4">
                    <h1 class="h3 mb-3">Új kategória feltöltése</h1>

                    <ul class="nav nav-pills mb-3 p-3 border border-primary bg-dark bg-opacity-25 rounded-3" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold active" data-bs-toggle="pill" href="#HU"><img src="images/flag-hu.png" width="20" height="15" alt="Magyar" /> Magyar</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#SR"><img src="images/flag-sr.png" width="20" height="15" alt="Szerb" /> Szerb</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#EN"><img src="images/flag-en.png" width="20" height="15" alt="Angol" /> Angol</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <form class="row js-validate-form" method="post" data-url="<%= process.env.APP_URL %>/admin/category/new/handle">

                            <div class="tab-pane show fade active" id="HU">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="category-name-hu" class="form-label">Kategória neve</label>
                                            <input type="text" data-rule-required="true" id="category-name-hu" class="form-control" name="name[hu]" value="" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="category-short-hu" class="form-label">Rövid leírás</label>
                                            <textarea id="category-short-hu" rows="5" name="short_description[hu]" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="SR">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="category-name-sr" class="form-label">Kategória neve szerbül</label>
                                            <input type="text" data-rule-required="true" id="category-name-sr" class="form-control" name="name[sr]" value="" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="category-short-sr" class="form-label">Rövid leírás szerbül</label>
                                            <textarea id="category-short-sr" rows="5" name="short_description[sr]" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="EN">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="category-name-en" class="form-label">Kategória neve angolul</label>
                                            <input type="text" data-rule-required="true" id="category-name-en" class="form-control" name="name[en]" value="" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="category-short-en" class="form-label">Rövid leírás angolul</label>
                                            <textarea id="category-short-en" rows="5" name="short_description[en]" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button class="btn btn-primary" type="submit">Mentés</button>
                            </div>
                        </form>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/bootstrap.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/chart.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/sweetalert.min.js') %>"></script>
        <script src="<%= getAssetPath('/js/plugins/validate.min.js') %>"></script>
        <script src="<%= getAssetPath('/js/plugins/validator_messages_hu.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/admin.js') %>"></script>
    </body>
</html>
