<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Kategóriák</h1>

                        <% if (webshopCategories.length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header">
                                    <i class="fas fa-table me-1"></i>
                                    Kategóriák
                                </div>
                                <div class="card-body">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th scope="col">Kategória neve</th>
                                                <th scope="col">Termékek száma</th>
                                                <th scope="col">Dátum (utoljára módosítva)</th>
                                                <th scope="col">Műveletek</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% webshopCategories.forEach(category => { %>
                                                <tr>
                                                    <td><%= category.name %></td>
                                                    <td><%- category.productsCount %></td>
                                                    <td><%= category.date %></td>
                                                    <td>
                                                        <i data-url="<%= process.env.APP_URL %>/admin/category/delete/<%= category.id %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                        <i role=button class="fas fa-edit link-dark mx-1"></i>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="js/plugins/jquery.min.js"></script>
        <script src="admin/js/plugins/bootstrap.min.js"></script>
        <script src="admin/js/plugins/chart.min.js"></script>
        <script src="admin/js/plugins/sweetalert.min.js"></script>
        <script src="admin/js/admin.js"></script>
    </body>
</html>
