<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('./layout/head.ejs') %>
    </head>
        <%- include('./layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Statisztikák</h1>

                        <ul class="nav nav-pills mb-3" role="tablist">
                            <li class="nav-item mx-2">
                                <a class="nav-link active" data-bs-toggle="pill" href="#products-statistics">Termékekről</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="pill" href="#order-statistics">Rendelésekről</a>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="products-statistics">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-area me-1"></i>
                                                Area Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myAreaChart" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-pie me-1"></i>
                                                Pie Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myPieChart" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-bar me-1"></i>
                                                Bar Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myBarChart" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-pie me-1"></i>
                                                Pie Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myPieChart-2" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="order-statistics">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-area me-1"></i>
                                                Area Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myAreaChart" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-pie me-1"></i>
                                                Pie Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myPieChart" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-bar me-1"></i>
                                                Bar Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myBarChart" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <i class="fas fa-chart-pie me-1"></i>
                                                Pie Chart Example
                                            </div>
                                            <div class="card-body"><canvas class="myPieChart-2" width="100%" height="40"></canvas></div>
                                            <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/bootstrap.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/chart.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/sweetalert.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/admin.js') %>"></script>
        <script type="text/javascript">
            // Pie Chart Example
            var ctxPieChart = document.getElementsByClassName("myPieChart");
            var myPieChart = new Chart(ctxPieChart, {
                type: 'pie',
                data: {
                    labels: ["Blue", "Red", "Yellow", "Green"],
                    datasets: [{
                        data: [12.21, 15.58, 11.25, 8.32],
                        backgroundColor: ['#007bff', '#dc3545', '#ffc107', '#28a745'],
                    }],
                },
            });

            var ctxPieChart2 = document.getElementsByClassName("myPieChart-2");
            var myPieChart = new Chart(ctxPieChart2, {
                type: 'pie',
                data: {
                    labels: ["Blue", "Red", "Yellow", "Green"],
                    datasets: [{
                        data: [15, 20, 9, 18],
                        backgroundColor: ['#007bff', '#dc3545', '#ffc107', '#28a745'],
                    }],
                },
            });
        </script>
        <% if (showOrdersCount) { %>
            <script type="text/javascript">
                // Area Chart Example
                var ctxAreChart = document.getElementsByClassName("myAreaChart");
                var myLineChart = new Chart(ctxAreChart, {
                    type: 'line',
                    data: {
                        labels: ["Jan", "Feb", "Márc", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szept", "Okt", "Nov", "Dec"],
                        datasets: [{
                            label: "Beérkezett rendelés",
                            lineTension: 0.3,
                            backgroundColor: "rgba(2,117,216,0.2)",
                            borderColor: "rgba(2,117,216,1)",
                            pointRadius: 5,
                            pointBackgroundColor: "rgba(2,117,216,1)",
                            pointBorderColor: "rgba(255,255,255,0.8)",
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: "rgba(2,117,216,1)",
                            pointHitRadius: 50,
                            pointBorderWidth: 2,
                            data: <%- JSON.stringify(ordersCountPerMonth) %>,
                        }],
                    },
                    options: {
                        scales: {
                            xAxes: [{
                                time: {
                                    unit: 'month'
                                },
                                gridLines: {
                                    display: true
                                },
                                ticks: {
                                    maxTicksLimit: 12
                                }
                            }],
                            yAxes: [{
                                ticks: {
                                    maxTicksLimit: 8,
                                    stepSize: 1,
                                    min: 0,
                                    max: <%- JSON.stringify(maxValueordersCount) %>,
                                },
                                gridLines: {
                                    color: "rgba(0, 0, 0, .125)",
                                }
                            }],
                        },
                        legend: {
                            display: false
                        }
                    }
                });
            </script>
        <% } %>
        <% if (showFinances) { %>
            <script type="text/javascript">
                // Bar Chart Example
                var ctxBarChart = document.getElementsByClassName("myBarChart");
                var myLineChart = new Chart(ctxBarChart, {
                    type: 'bar',
                    data: {
                        labels: ["Jan", "Feb", "Márc", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szept", "Okt", "Nov", "Dec"],
                        datasets: [{
                            label: "Bevétel (RSD)",
                            backgroundColor: "rgba(2,117,216,1)",
                            borderColor: "rgba(2,117,216,1)",
                            data: <%- JSON.stringify(financesPerMonth) %>,
                        }],
                    },
                    options: {
                        scales: {
                            xAxes: [{
                                time: {
                                    unit: 'month'
                                },
                                gridLines: {
                                    display: true
                                },
                                ticks: {
                                    maxTicksLimit: 12
                                }
                            }],
                            yAxes: [{
                                ticks: {
                                    maxTicksLimit: 10,
                                    min: 0,
                                    max: <%- JSON.stringify(maxValueFromMonths) %>,
                                },
                                gridLines: {
                                    display: true
                                }
                            }],
                        },
                        legend: {
                            display: false
                        }
                    }
                });
            </script>
        <% } %>
    </body>
</html>
