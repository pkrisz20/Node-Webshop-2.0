<%- extend('layouts/admin') %>

<%- section('content') %>
    <main class="p-4">
        <h1 class="h3 mb-3">Tartalom szerkesztése</h1>

        <ul class="nav nav-pills mb-3 p-3 border border-primary bg-dark bg-opacity-25 rounded-3" role="tablist">
            <li class="nav-item">
                <a class="nav-link fw-semibold active" data-bs-toggle="pill" href="#HU">Általános adatok + <img src="images/flag-hu.png" width="20" height="15" alt="Magyar" /> Magyar</a>
            </li>
            <li class="nav-item mx-2">
                <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#SR"><img src="images/flag-sr.png" width="20" height="15" alt="Szerb" /> Szerb</a>
            </li>
            <li class="nav-item mx-2">
                <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#EN"><img src="images/flag-en.png" width="20" height="15" alt="Angol" /> Angol</a>
            </li>
        </ul>

        <div class="tab-content">
            <form
                class="row js-validate-form"
                method="post"
                data-url="<%= process.env.APP_URL %>/admin/static-contents/edit/handle/<%= formValues.id %>"
            >
                <div class="tab-pane show fade active" id="HU">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-row mb-3">
                                <label for="content-title-hu" class="form-label">Tartalom címe</label>
                                <input type="text" data-rule-required="true" id="content-title-hu" class="form-control" name="title[hu]" value="<%= formValues.hu.title %>" />
                            </div>

                            <div class="form-check form-switch d-inline-block">
                                <input class="form-check-input js-boolean-checkbox" type="checkbox" disabled="disabled" checked value="<%= formValues.is_active %>" name="is_active" id="content-is-active" role="switch" />
                                <label class="form-check-label ms-sm-2 lh-lg" for="content-is-active">Aktív</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-row">
                                <label for="content-short-hu" class="form-label">Rövid leírás</label>
                                <textarea id="content-short-hu" rows="5" name="short_description[hu]" class="form-control"><%= formValues.hu.short_description ? formValues.hu.short_description : '' %></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label for="content-long-hu" class="form-label">Hosszú leírás</label>
                        <textarea id="content-long-hu" name="content_description[hu]" class="form-control js-ckeditor"><%= formValues.hu.description ? formValues.hu.description : '' %></textarea>
                    </div>

                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Mentés</button>
                    </div>
                </div>

                <div class="tab-pane fade" id="SR">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-row">
                                <label for="content-name-sr" class="form-label">Cikk címe szerbül</label>
                                <input type="text" data-rule-required="true" id="content-name-sr" class="form-control" name="title[sr]" value="<%= formValues.sr.title %>" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-row">
                                <label for="content-short-sr" class="form-label">Rövid leírás szerbül</label>
                                <textarea id="content-short-sr" rows="5" name="short_description[sr]" class="form-control"><%= formValues.sr.short_description ? formValues.sr.short_description : '' %></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-3">
                        <label for="content-long-sr" class="form-label">Hosszú leírás szerbül</label>
                        <textarea id="content-long-sr" name="content_description[sr]" class="form-control js-ckeditor"><%= formValues.sr.description ? formValues.sr.description : '' %></textarea>
                    </div>
                </div>

                <div class="tab-pane fade" id="EN">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-row">
                                <label for="content-name-en" class="form-label">Cikk címe angolul</label>
                                <input type="text" data-rule-required="true" id="content-name-en" class="form-control" name="title[en]" value="<%= formValues.en.title %>" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-row">
                                <label for="content-short-en" class="form-label">Rövid leírás angolul</label>
                                <textarea id="content-short-en" rows="5" name="short_description[en]" class="form-control"><%= formValues.en.short_description ? formValues.en.short_description : '' %></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-3">
                        <label for="content-long-en" class="form-label">Hosszú leírás angolul</label>
                        <textarea id="content-long-en" name="content_description[en]" class="form-control js-ckeditor"><%= formValues.en.description ? formValues.en.description : '' %></textarea>
                    </div>
                </div>
            </form>
        </div>
    </main>
<%- endSection() %>

<%- push('plugins') %>
    <script src="<%= getAssetPath('/admin/js/plugins/ckeditor.min.js') %>"></script>
    <%- include('../../partials/validation-scripts.ejs', { recaptcha: false }) %>
<%- endPush() %>
