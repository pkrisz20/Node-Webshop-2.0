<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Gallériák</h1>

                        <% if (staticPages.length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div class="fs-5">
                                        <i class="fas fa-lock"></i>
                                        Statikus tartalmak
                                    </div>
                                </div>

                                <div class="card-body table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th scope="col">Tartalom címe</th>
                                                <th scope="col">Látható</th>
                                                <th scope="col">Dátum (utoljára módosítva)</th>
                                                <th scope="col">Műveletek</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% staticPages.forEach(content => { %>
                                                <tr>
                                                    <td><%= content.title %></td>
                                                    <td><%- content.is_active %></td>
                                                    <td><%= content.updated_at %></td>
                                                    <td>
                                                        <a class="link-dark mx-1" href="<%= process.env.APP_URL %>/admin/static-contents/edit/<%= content.id %>">
                                                            <i role=button class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/bootstrap.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/chart.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/plugins/sweetalert.min.js') %>"></script>
        <script src="<%= getAssetPath('/admin/js/admin.js') %>"></script>
    </body>
</html>
