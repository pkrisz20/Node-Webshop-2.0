<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('../layout/head.ejs') %>
    </head>
        <%- include('../layout/sidebar-navs.ejs') %>

                <main class="p-4">
                    <h1 class="h3 mb-3">Új cikk feltöltése</h1>

                    <ul class="nav nav-pills mb-3 p-3 border border-primary bg-dark bg-opacity-25 rounded-3" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold active" data-bs-toggle="pill" href="#HU">Általános adatok + <img src="images/flag-hu.png" width="20" height="15" alt="Magyar" /> Magyar</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#SR"><img src="images/flag-sr.png" width="20" height="15" alt="Szerb" /> Szerb</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#EN"><img src="images/flag-en.png" width="20" height="15" alt="Angol" /> Angol</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <form class="row js-validate-form" method="post" data-url="<%= process.env.APP_URL %>/admin/blogs/new/handle">

                            <div class="tab-pane show fade active" id="HU">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="article-name-hu" class="form-label">Cikk címe</label>
                                            <input type="text" data-rule-required="true" id="article-name-hu" class="form-control" name="title[hu]" value="" />
                                        </div>
                                        <div class="form-row">
                                            <label for="article-date" class="form-label">Cikk dátuma</label>
                                            <input type="date" data-rule-required="true" id="article-date" class="form-control" name="date" value="<%= new Date().getFullYear() + '-' + (new Date().getMonth() + 1) + '-' + new Date().getDate() %>" />
                                        </div>
                                        <div class="form-row">
                                            <label for="article-author" class="form-label">Szerző</label>
                                            <input type="text" data-rule-required="true" id="article-author" class="form-control" name="author" value="" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="article-short-hu" class="form-label">Rövid leírás</label>
                                            <textarea id="article-short-hu" rows="5" name="short_description[hu]" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" value="0" name="is_active" id="article-is-active" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="article-is-active">Aktív</label>
                                        </div>
                                        <div class="form-check form-switch ms-sm-2 d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" value="0" name="is_featured" id="article-is-featured" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="article-is-featured">Főoldali kiemelés</label>
                                        </div>
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input js-boolean-checkbox" type="checkbox" value="0" name="comments_allowed" id="article-comments-allowed" role="switch" />
                                            <label class="form-check-label ms-sm-2 lh-lg" for="article-comments-allowed">Hozzászólások engedélyezése</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="article-long-hu" class="form-label">Hosszú leírás</label>
                                    <textarea id="article-long-hu" name="article_description[hu]" class="form-control js-ckeditor"></textarea>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="SR">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="article-name-sr" class="form-label">Cikk címe szerbül</label>
                                            <input type="text" data-rule-required="true" id="article-name-sr" class="form-control" name="title[sr]" value="" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="article-short-sr" class="form-label">Rövid leírás szerbül</label>
                                            <textarea id="article-short-sr" rows="5" name="short_description[sr]" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="article-long-sr" class="form-label">Hosszú leírás szerbül</label>
                                    <textarea id="article-long-sr" name="article_description[sr]" class="form-control js-ckeditor"></textarea>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="EN">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="article-name-en" class="form-label">Cikk címe angolul</label>
                                            <input type="text" data-rule-required="true" id="article-name-en" class="form-control" name="title[en]" value="" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-row">
                                            <label for="article-short-en" class="form-label">Rövid leírás angolul</label>
                                            <textarea id="article-short-en" rows="5" name="short_description[en]" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="article-long-en" class="form-label">Hosszú leírás angolul</label>
                                    <textarea id="article-long-en" name="article_description[en]" class="form-control js-ckeditor"></textarea>
                                </div>
                            </div>

                            <div class="col-12">
                                <button class="btn btn-primary" type="submit">Mentés</button>
                            </div>
                        </form>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="js/plugins/jquery.min.js"></script>
        <script src="admin/js/plugins/bootstrap.min.js"></script>
        <script src="admin/js/plugins/chart.min.js"></script>
        <script src="admin/js/plugins/sweetalert.min.js"></script>
        <script src="admin/js/plugins/ckeditor.min.js"></script>
        <script src="js/plugins/validate.min.js"></script>
        <script src="js/plugins/validator_messages_hu.js"></script>
        <script src="admin/js/admin.js"></script>
    </body>
</html>
