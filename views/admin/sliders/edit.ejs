<%- extend('layouts/admin') %>

<%- section('content') %>
    <main class="p-4">
        <h1 class="h3 mb-3">Forgó szerkesztése</h1>

        <ul class="nav nav-pills mb-3 p-3 border border-primary bg-dark bg-opacity-25 rounded-3" role="tablist">
            <li class="nav-item">
                <a class="nav-link fw-semibold active" data-bs-toggle="pill" href="#HU"><img src="images/flag-hu.png" width="20" height="15" alt="Magyar" /> Magyar</a>
            </li>
            <li class="nav-item mx-2">
                <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#SR"><img src="images/flag-sr.png" width="20" height="15" alt="Szerb" /> Szerb</a>
            </li>
            <li class="nav-item mx-2">
                <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#EN"><img src="images/flag-en.png" width="20" height="15" alt="Angol" /> Angol</a>
            </li>
            <li class="nav-item mx-2">
                <a class="nav-link fw-semibold" data-bs-toggle="pill" href="#media-thumbnail"><i class="fas fa-photo-video"></i> Kép</a>
            </li>
        </ul>

        <div class="tab-content">
            <form class="row js-validate-form" method="post" data-url="<%= process.env.APP_URL %>/admin/slider/edit/handle/<%= formValues.id %>">

                <div class="tab-pane show fade active" id="HU">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-row mb-3">
                                <label for="slider-name-hu" class="form-label">Forgó címe</label>
                                <input type="text" data-rule-required="true" id="slider-name-hu" class="form-control" name="title[hu]" value="<%= formValues.hu.title %>" />
                            </div>
                            <div class="form-row mb-3">
                                <label for="slider-button-hu" class="form-label">Gomb szövege</label>
                                <input type="text" id="slider-button-hu" class="form-control" name="button[hu]" value="<%= formValues.hu.button || '' %>" />
                            </div>
                            <div class="form-row">
                                <label for="slider-link-hu" class="form-label">Link</label>
                                <input type="text" data-rule-url="true" id="slider-link-hu" class="form-control" name="link[hu]" value="<%= formValues.hu.link || '' %>" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-row mb-3">
                                <label for="slider-short-hu" class="form-label">Rövid leírás</label>
                                <textarea id="slider-short-hu" rows="5" name="subtitle[hu]" class="form-control"><%= formValues.hu.subtitle || '' %></textarea>
                            </div>
                            <div class="form-check form-switch d-inline-block">
                                <input class="form-check-input js-boolean-checkbox" type="checkbox" value="<%= formValues.is_active %>" <%= formValues.is_active === 1 ? 'checked' : '' %> name="is_active" id="slider-is-active" role="switch" />
                                <label class="form-check-label ms-sm-2 lh-lg" for="slider-is-active">Aktív</label>
                            </div>
                            <div class="ms-sm-3 d-inline-block">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="target_page" id="target_page_blank" value="_blank" <%= formValues.target_page === '_blank' ? 'checked' : '' %> />
                                    <label class="form-check-label" for="target_page_blank">
                                        Új oldalon nyíljon
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="target_page" id="target_page_self" value="_self" <%= formValues.target_page === '_self' ? 'checked' : '' %> />
                                    <label class="form-check-label" for="target_page_self">
                                        Meglévő oldalon nyíljon
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="SR">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-row mb-3">
                                <label for="slider-name-sr" class="form-label">Forgó címe szerbül</label>
                                <input type="text" data-rule-required="true" id="slider-name-sr" class="form-control" name="title[sr]" value="<%= formValues.sr.title %>" />
                            </div>
                            <div class="form-row mb-3">
                                <label for="slider-button-sr" class="form-label">Gomb szövege szerbül</label>
                                <input type="text" id="slider-button-sr" class="form-control" name="button[sr]" value="<%= formValues.sr.button || '' %>" />
                            </div>
                            <div class="form-row">
                                <label for="slider-link-sr" class="form-label">Link szerben</label>
                                <input type="text" data-rule-url="true" id="slider-link-sr" class="form-control" name="link[sr]" value="<%= formValues.sr.link || '' %>" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-row mb-3">
                                <label for="slider-short-sr" class="form-label">Rövid leírás szerbül</label>
                                <textarea id="slider-short-sr" rows="5" name="subtitle[sr]" class="form-control"><%= formValues.sr.subtitle || '' %></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="EN">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-row mb-3">
                                <label for="slider-name-en" class="form-label">Forgó címe angolul</label>
                                <input type="text" data-rule-required="true" id="slider-name-en" class="form-control" name="title[en]" value="<%= formValues.en.title %>" />
                            </div>
                            <div class="form-row mb-3">
                                <label for="slider-button-en" class="form-label">Gomb szövege angolul</label>
                                <input type="text" id="slider-button-en" class="form-control" name="button[en]" value="<%= formValues.en.button || '' %>" />
                            </div>
                            <div class="form-row">
                                <label for="slider-link-en" class="form-label">Link angolon</label>
                                <input type="text" data-rule-url="true" id="slider-link-en" class="form-control" name="link[en]" value="<%= formValues.en.link || '' %>" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-row">
                                <label for="slider-short-en" class="form-label">Rövid leírás angolul</label>
                                <textarea id="slider-short-en" rows="5" name="subtitle[en]" class="form-control"><%= formValues.en.subtitle || '' %></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <button class="btn btn-primary" type="submit">Mentés</button>
                </div>
            </form>

            <div class="tab-pane fade" id="media-thumbnail">
                <%- include('../components/image-uploader.ejs', { single: true, whereToUpload: "heros", databaseID: formValues.id, uploadedImages: formValues.image }) %>
            </div>
        </div>
    </main>
<%- endSection() %>

<%- push('plugins') %>
    <%- include('../../partials/validation-scripts.ejs', { recaptcha: false }) %>
<%- endPush() %>

<%- push('scripts') %>
    <script src="<%= getAssetPath('/admin/js/image-uploader.js') %>"></script>
<%- endPush() %>
