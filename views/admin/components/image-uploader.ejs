<% if (locals.single) { %>
    <form method="post" enctype="multipart/form-data" accept="image/*" data-url="<%= process.env.APP_URL %>/admin/single-upload/<%= whereToUpload %>" class="col-6 js-image-upload-form">

<% } else if (locals.multiple) { %>
    <form method="post" enctype="multipart/form-data" accept="image/*" data-url="<%= process.env.APP_URL %>/admin/multiple-upload/<%= whereToUpload %>" class="col-6 js-image-upload-form">

<% } %>
    <div class="mb-3">
        <% if (locals.single) { %>
            <label for="files" class="form-label">Indexkép feltöltése</label>
            <input class="form-control js-file-input" data-id="<%= databaseID %>" name="files" type="file" id="files" />
        <% } else if (locals.multiple) { %>
            <label for="files" class="form-label">Képek feltöltése</label>
            <input class="form-control js-file-input" data-id="<%= databaseID %>" name="files" type="file" id="files" multiple />
            <small class="text-muted">Kiválaszthatsz akár több képet is egyszerre. (max. 20 darab)</small>
        <% } %>
    </div>

    <button class="btn btn-primary js-upload-submit" type="submit">Feltöltés</button>
</form>

<% if (locals.uploadedImages && locals.uploadedImages.length > 0) { %>
    <div class="mt-5">
        <% if (locals.single) { %>
            <h2 class="fs-5">Feltöltött indexkép</h2>
        <% } else if (locals.multiple) { %>
            <h2 class="fs-5">Feltöltött képek</h2>
        <% } %>

        <% if (locals.single) { %>
            <div class="d-flex mw-100" style="flex-wrap: wrap; gap: 10px;">
                <div class="position-relative js-image-item" style="min-width: 200px;">
                    <button
                        type="button"
                        data-id="<%= databaseID %>"
                        data-type="single"
                        data-url="<%= process.env.APP_URL %>/admin/delete-image/<%= whereToUpload %>"
                        class="js-delete-image btn btn-danger position-absolute"
                        style="left: 5px; bottom: 5px; font-size: 12px;"
                    >
                        <i class="fas fa-trash"></i> Törlés
                    </button>
                    <img src="<%= uploadedImages %>" width="200" class="img-thumbnail js-uploaded-image" />
                </div>
            </div>
        <% } else if (locals.multiple) { %>
            <div class="d-flex mw-100" style="flex-wrap: wrap; gap: 10px;">
                <% uploadedImages.forEach( image => { %>
                    <div class="position-relative js-image-item" style="min-width: 200px;">
                        <button
                            type="button"
                            data-id="<%= databaseID %>"
                            data-type="multiple"
                            data-url="<%= process.env.APP_URL %>/admin/delete-image/<%= whereToUpload %>"
                            class="js-delete-image btn btn-danger position-absolute"
                            style="left: 5px; bottom: 5px; font-size: 12px;"
                        >
                            <i class="fas fa-trash"></i> Törlés
                        </button>
                        <img src="<%= image %>" width="200" class="img-thumbnail js-uploaded-image" />
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
<% } %>
