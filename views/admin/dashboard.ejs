<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('./layout/head.ejs') %>
    </head>
        <%- include('./layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Kezdőlap</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">Farma Gusaka</li>
                        </ol>

                        <!-- ORDER COUNTERS -->
                        <div class="row">
                            <span class="mb-2 fs-4 color-dark fw-semibold">Összes rendelés: <%= orderCounts.totalOrders %></span>

                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-secondary text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.new %></div>
                                    <div class="card-footer d-flex align-items-center">Új rendelés</div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-primary text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.in_process %></div>
                                    <div class="card-footer d-flex align-items-center">Folyamatban levő rendelés</div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-success text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.finished %></div>
                                    <div class="card-footer d-flex align-items-center">Lazárt rendelés</div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-danger text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.canceled %></div>
                                    <div class="card-footer d-flex align-items-center">Lemondott rendelés</div>
                                </div>
                            </div>
                        </div>

                        <!-- ORDER CHARTS -->
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        Éves bevétel
                                    </div>
                                    <div class="card-body"><canvas id="myAreaChart" width="100%" height="40"></canvas></div>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <i class="fas fa-chart-bar me-1"></i>
                                        Havi bevétel RSD-ben (<%= new Date().getFullYear() %>)
                                    </div>
                                    <div class="card-body"><canvas id="myBarChart" width="100%" height="40"></canvas></div>
                                </div>
                            </div>
                        </div>

                        <!-- LAST ORDERS TABLE -->
                        <% if (lastOrders.length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header">
                                    <i class="fas fa-table me-1"></i>
                                    Utolsó rendelések
                                </div>
                                <div class="card-body">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                        <tr>
                                            <th scope="col">Azonosító</th>
                                            <th scope="col">Keresztnév</th>
                                            <th scope="col">Vezetéknév</th>
                                            <th scope="col">Helység</th>
                                            <th scope="col">Telefon</th>
                                            <th scope="col">Státusz</th>
                                            <th scope="col">Összeg</th>
                                            <th scope="col">Rendelés dátuma</th>
                                            <th scope="col">Műveletek</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                            <% lastOrders.forEach(order => { %>
                                                <tr>
                                                    <td><%= order.id %></td>
                                                    <td><%= order.firstname %></td>
                                                    <td><%= order.lastname %></td>
                                                    <td><%= order.city %></td>
                                                    <td><%= order.phone %></td>
                                                    <td><span class="badge <%= order.statusData.statusClass %>"><%= order.statusData.statusText %></span></td>
                                                    <td><%= order.sumPrice %> RSD</td>
                                                    <td><%= order.orderDate %></td>
                                                    <td>
                                                        <i role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                        <i role=button class="fas fa-edit link-dark mx-1"></i>
                                                        <i role=button class="fas fa-info-circle link-primary"></i>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="js/plugins/jquery.min.js"></script>
        <script src="admin/js/plugins/bootstrap.min.js"></script>
        <script src="admin/js/plugins/chart.min.js"></script>
        <script src="admin/js/plugins/sweetalert.min.js"></script>
        <script src="admin/js/admin.js"></script>
        <script type="text/javascript">
            // Bar Chart Example
            var ctxBarChart = document.getElementById("myBarChart");
            var myLineChart = new Chart(ctxBarChart, {
                type: 'bar',
                data: {
                    labels: ["Jan", "Feb", "Márc", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szept", "Okt", "Nov", "Dec"],
                    datasets: [{
                        backgroundColor: "rgba(2,117,216,1)",
                        borderColor: "rgba(2,117,216,1)",
                        data: <%- JSON.stringify(financesPerMonth) %>,
                    }],
                },
                options: {
                    scales: {
                        xAxes: [{
                            time: {
                                unit: 'month'
                            },
                            gridLines: {
                                display: true
                            },
                            ticks: {
                                maxTicksLimit: 12
                            }
                        }],
                        yAxes: [{
                            ticks: {
                                min: 0,
                                max: <%- JSON.stringify(maxValueFromMonths) %>,
                            },
                            gridLines: {
                                display: true
                            }
                        }],
                    },
                    legend: {
                        display: false
                    }
                }
            });
        </script>
    </body>
</html>
