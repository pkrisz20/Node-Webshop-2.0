<!DOCTYPE html>
<html lang="hu">
        <!-- HEAD + STYLE LINKS -->
        <%- include('./layout/head.ejs') %>
        <style type="text/css">
            .selectable-statuses-container {
                visibility: hidden;
                opacity: 0;
                transition: all .3s ease;
                display: flex;
                align-items: center;
                background-color: #0d6efd;
                position: absolute;
                top: -25px;
                left: 50%;
                transform: translateX(-50%);
            }
            .selectable-order-status {
                transition: all .3s ease;
                text-transform: capitalize;
            }
            .selectable-order-status:not(:last-child) {
                margin-right: 4px;
            }
            .selectable-order-status:hover {
                background-color: #fd7e14 !important;
                color: #2a2a2a;
            }
            .selectable-order-status::after {
                position: absolute;
                bottom: -6px;
                left: 50%;
                height: 0px;
                width: 0px;
                content: "";
                border-right: solid 7px transparent;
                border-left: solid 7px transparent;
                border-top: solid 7px #0d6efd;
            }
        </style>
    </head>
        <%- include('./layout/sidebar-navs.ejs') %>

                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Kezdőlap</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">Farma Gusaka</li>
                        </ol>

                        <!-- ORDER COUNTERS -->
                        <div class="row">
                            <span class="mb-2 fs-4 color-dark fw-semibold">Összes rendelés: <%= orderCounts.totalOrders %></span>

                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-secondary text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.new %></div>
                                    <div class="card-footer d-flex align-items-center">Új rendelés</div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-primary text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.in_process %></div>
                                    <div class="card-footer d-flex align-items-center">Folyamatban levő rendelés</div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-success text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.finished %></div>
                                    <div class="card-footer d-flex align-items-center">Lazárt rendelés</div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card bg-danger text-white mb-4">
                                    <div class="card-body fs-2"><%= orderCounts.canceled %></div>
                                    <div class="card-footer d-flex align-items-center">Lemondott rendelés</div>
                                </div>
                            </div>
                        </div>

                        <!-- ORDER CHARTS -->
                        <div class="row">
                            <% if (showOrdersCount) { %>
                                <div class="col-xl-6">
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <i class="fas fa-chart-area me-1"></i>
                                            Beérkezett rendelések száma (<%= new Date().getFullYear() %>)
                                        </div>
                                        <div class="card-body"><canvas id="myAreaChart" width="100%" height="40"></canvas></div>
                                    </div>
                                </div>
                            <% } else if (!showOrdersCount) { %>
                                <div class="col-xl-6">
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <i class="fas fa-chart-area me-1"></i>
                                            Beérkezett rendelések száma (<%= new Date().getFullYear() %>)
                                        </div>
                                        <div class="card-body">
                                            <strong>Ebben az évben még nem érkezett új rendelés.</strong>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                            <% if (showFinances) { %>
                                <div class="col-xl-6">
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <i class="fas fa-chart-bar me-1"></i>
                                            Havi bevétel RSD-ben (<%= new Date().getFullYear() %>)
                                        </div>
                                        <div class="card-body"><canvas id="myBarChart" width="100%" height="40"></canvas></div>
                                    </div>
                                </div>
                            <% } else if (!showFinances) { %>
                                <div class="col-xl-6">
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <i class="fas fa-chart-area me-1"></i>
                                            Havi bevétel RSD-ben (<%= new Date().getFullYear() %>)
                                        </div>
                                        <div class="card-body">
                                            <strong>Ebben az évben még nincs lezárt rendelés.</strong>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- LAST ORDERS TABLE -->
                        <% if (lastOrders.length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header">
                                    <i class="fas fa-table me-1"></i>
                                    Utolsó rendelések (15)
                                </div>
                                <div class="card-body table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th scope="col">Keresztnév</th>
                                                <th scope="col">Vezetéknév</th>
                                                <th scope="col">Helység</th>
                                                <th scope="col">Telefon</th>
                                                <th scope="col">Státusz</th>
                                                <th scope="col">Összeg</th>
                                                <th scope="col">Rendelés dátuma</th>
                                                <th scope="col">Műveletek</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% lastOrders.forEach(order => { %>
                                                <tr>
                                                    <td><%= order.firstname %></td>
                                                    <td><%= order.lastname %></td>
                                                    <td><%= order.city %></td>
                                                    <td><%= order.phone %></td>
                                                    <td
                                                        <%= order.can_edit_status ? "role=button" : '' %>
                                                        class="<%= order.can_edit_status ? 'js-open-edit-order position-relative' : '' %>"
                                                    >
                                                        <% if (order.can_edit_status) { %>
                                                            <div class="selectable-statuses-container bg-orange p-1 rounded-1 js-statuses-container">
                                                                <% order.selectableStatuses.forEach(selectableStatus => { %>
                                                                    <button
                                                                        class="selectable-order-status badge bg-dark fw-medium border-0 js-status-btn"
                                                                        data-status="<%= selectableStatus %>"
                                                                        data-url="<%= process.env.APP_URL %>/admin/order/change-status/<%= order.id %>"
                                                                    >
                                                                        <%= languageHandler('order_status.' + selectableStatus, process.env.ADMIN_LANG) %>
                                                                    </button>
                                                                <% }) %>
                                                            </div>
                                                        <% } %>
                                                        <span class="badge fw-medium <%= order.statusData.statusClass %>"><%= order.statusData.statusText %></span>
                                                    </td>
                                                    <td><%= order.sumPrice %> RSD</td>
                                                    <td><%= order.orderDate %></td>
                                                    <td>
                                                        <i data-url="<%= process.env.APP_URL %>/admin/order/delete/<%= order.id %>" role=button class="fas fa-trash-alt link-danger js-delete-data"></i>
                                                        <i data-url="<%= process.env.APP_URL %>/admin/order/get-info/<%= order.id %>" role=button class="fas fa-info-circle link-primary js-get-order-info"></i>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </main>
            </div>
        </div>

        <!-- SCRIPTS -->
        <script src="js/plugins/jquery.min.js"></script>
        <script src="admin/js/plugins/bootstrap.min.js"></script>
        <script src="admin/js/plugins/chart.min.js"></script>
        <script src="admin/js/plugins/sweetalert.min.js"></script>
        <script src="admin/js/admin.js"></script>
        <% if (showOrdersCount) { %>
            <script type="text/javascript">
                // Area Chart Example
                var ctxAreChart = document.getElementById("myAreaChart");
                var myLineChart = new Chart(ctxAreChart, {
                    type: 'line',
                    data: {
                        labels: ["Jan", "Feb", "Márc", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szept", "Okt", "Nov", "Dec"],
                        datasets: [{
                            label: "Beérkezett rendelés",
                            lineTension: 0.3,
                            backgroundColor: "rgba(2,117,216,0.2)",
                            borderColor: "rgba(2,117,216,1)",
                            pointRadius: 5,
                            pointBackgroundColor: "rgba(2,117,216,1)",
                            pointBorderColor: "rgba(255,255,255,0.8)",
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: "rgba(2,117,216,1)",
                            pointHitRadius: 50,
                            pointBorderWidth: 2,
                            data: <%- JSON.stringify(ordersCountPerMonth) %>,
                        }],
                    },
                    options: {
                        scales: {
                            xAxes: [{
                                time: {
                                    unit: 'month'
                                },
                                gridLines: {
                                    display: true
                                },
                                ticks: {
                                    maxTicksLimit: 12
                                }
                            }],
                            yAxes: [{
                                ticks: {
                                    maxTicksLimit: 8,
                                    stepSize: 1,
                                    min: 0,
                                    max: <%- JSON.stringify(maxValueordersCount) %>,
                                },
                                gridLines: {
                                    color: "rgba(0, 0, 0, .125)",
                                }
                            }],
                        },
                        legend: {
                            display: false
                        }
                    }
                });
            </script>
        <% } %>
        <% if (showFinances) { %>
            <script type="text/javascript">
                // Bar Chart Example
                var ctxBarChart = document.getElementById("myBarChart");
                var myLineChart = new Chart(ctxBarChart, {
                    type: 'bar',
                    data: {
                        labels: ["Jan", "Feb", "Márc", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szept", "Okt", "Nov", "Dec"],
                        datasets: [{
                            label: "Bevétel (RSD)",
                            backgroundColor: "rgba(2,117,216,1)",
                            borderColor: "rgba(2,117,216,1)",
                            data: <%- JSON.stringify(financesPerMonth) %>,
                        }],
                    },
                    options: {
                        scales: {
                            xAxes: [{
                                time: {
                                    unit: 'month'
                                },
                                gridLines: {
                                    display: true
                                },
                                ticks: {
                                    maxTicksLimit: 12
                                }
                            }],
                            yAxes: [{
                                ticks: {
                                    maxTicksLimit: 10,
                                    min: 0,
                                    max: <%- JSON.stringify(maxValueFromMonths) %>,
                                },
                                gridLines: {
                                    display: true
                                }
                            }],
                        },
                        legend: {
                            display: false
                        }
                    }
                });
            </script>
        <% } %>
    </body>
</html>
