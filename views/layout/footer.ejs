<footer class="footer">
    <div class="footer-top">
        <div class="wrapper">
            <a class="footer-logo" target="_self" href="<%= process.env.APP_URL %>/<%= current_locale %>" aria-label="<%= process.env.SITE_NAME %> home page link">

                <%- include('../components/picture.ejs', {
                    imageURL: true,
                    imgClass: "logo-img",
                    webpImage: getAssetPath('/images/logo.webp'),
                    imageSrc: getAssetPath('/images/logo.png'),
                    alt: process.env.SITE_NAME + " footer logo",
                }) %>
            </a>
        </div>
    </div>
    <div class="footer-middle">
        <div class="wrapper">
            <div class="footer-middle-container">
                <% if (DB_CONFIG["phone_1"] || DB_CONFIG["phone_2"] || DB_CONFIG["email"] || DB_CONFIG["company_street"]) { %>
                    <div class="footer-middle-col">
                        <h3 class="footer-title"><%= languageHandler('nav.contact', current_locale) %></h3>
                        <% if (DB_CONFIG["phone_1"]) { %>
                            <a class="footer-title-link" aria-label="<%= DB_CONFIG["phone_1"] %>" href="tel:0611237896"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_1"] %></a>
                        <% } %>
                        <% if (DB_CONFIG["phone_2"]) { %>
                            <a class="footer-title-link" aria-label="<%= DB_CONFIG["phone_2"] %>" href="tel:0631234567"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_2"] %></a>
                        <% } %>
                        <% if (DB_CONFIG["email"]) { %>
                            <a class="footer-title-link" aria-label="<%= DB_CONFIG["email"] %>" href="mail:<%= DB_CONFIG["email"] %>"><i class="fas fa-envelope"></i> <%= DB_CONFIG["email"] %></a>
                        <% } %>
                        <% if (DB_CONFIG["company_street"]) { %>
                            <a target="_self" class="footer-title-link" aria-label="Map" href="<%= process.env.APP_URL %>/<%= current_locale %>"><i class="fas fa-map-marker-alt"></i> <%= DB_CONFIG["company_street"] %></a>
                        <% } %>
                    </div>
                <% } %>
                <div class="footer-middle-col">
                    <h3 class="footer-title"><%= languageHandler('nav.quick_links', current_locale) %></h3>
                    <a target="_self" class="footer-title-link" aria-label="<%= languageHandler('nav.about', current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/about"><%= languageHandler('nav.about', current_locale) %></a>
                    <a target="_self" class="footer-title-link" aria-label="<%= languageHandler('general.products', current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/products"><%= languageHandler('general.products', current_locale) %></a>
                    <a target="_self" class="footer-title-link" aria-label="<%= languageHandler('nav.gallery', current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/gallery"><%= languageHandler('nav.gallery', current_locale) %></a>
                    <a target="_self" class="footer-title-link" aria-label="<%= languageHandler('nav.blog', current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/blogs"><%= languageHandler('nav.blog', current_locale) %></a>
                    <a target="_self" class="footer-title-link" aria-label="<%= languageHandler('nav.contact', current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/contact"><%= languageHandler('nav.contact', current_locale) %></a>
                </div>
                <div class="footer-middle-col">
                    <h3 class="footer-title"><%= languageHandler('nav.support', current_locale) %></h3>
                    <a target="_self" href="<%= process.env.APP_URL %>/<%= current_locale %>/faq" aria-label="<%= languageHandler('nav.FAQ', current_locale) %>" class="footer-title-link"><i class="fas fa-question-circle"></i> <%= languageHandler('nav.FAQ', current_locale) %></a>

                    <a target="_self" href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= staticContent['terms_of_use']['slug'] %>" aria-label="<%= staticContent['terms_of_use']['title'] %>" class="footer-title-link"><i class="fas fa-hand-point-right"></i> <%= staticContent['terms_of_use']['title'] %></a>

                    <a target="_self" href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= staticContent['privacy_policy']['slug'] %>" aria-label="<%= staticContent['privacy_policy']['title'] %>" class="footer-title-link"><i class="fas fa-shield-alt"></i> <%= staticContent['privacy_policy']['title'] %></a>
                </div>
                <% if (DB_CONFIG["facebook"] || DB_CONFIG["instagram"] || DB_CONFIG["tiktok"]) { %>
                    <div class="footer-middle-col">
                        <h3 class="footer-title"><%= languageHandler('general.follow_us', current_locale) %></h3>
                        <% if (DB_CONFIG["facebook"]) { %>
                            <a href="<%= DB_CONFIG["facebook"] %>" aria-label="Link to social media facebook" target="blank" class="footer-title-link social"><i class="fab fa-facebook"></i> Facebook</a>
                        <% } %>
                        <% if (DB_CONFIG["instagram"]) { %>
                            <a href="<%= DB_CONFIG["instagram"] %>" aria-label="Link to social media instagram" target="blank" class="footer-title-link social"><i class="fab fa-instagram"></i> Instagram</a>
                        <% } %>
                        <% if (DB_CONFIG["tiktok"]) { %>
                            <a href="<%= DB_CONFIG["tiktok"] %>" aria-label="Link to social media tiktok" target="blank" class="footer-title-link social"><i class="fab fa-tiktok"></i> TikTok</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="wrapper">
            <div class="footer-bottom-row">
                <strong><%= process.env.SITE_NAME %> &copy; <%= new Date().getFullYear() %>. <%= languageHandler('validations.rights_reserved', current_locale) %>.</strong>
            </div>
        </div>
    </div>
</footer>

<% if (process.env.GTAG_ID || false) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GTAG_ID %>"></script>
    <script type="text/javascript">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= process.env.GTAG_ID %>');
    </script>
<% } %>
