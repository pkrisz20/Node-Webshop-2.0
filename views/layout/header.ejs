<header class="header js-header">
  <div class="header-top">
    <div class="wrapper">
      <div class="header-top-contacts">
        <a href="mailto:<%= DB_CONFIG["email"] %>" aria-label="Link to send a mail"><i class="fas fa-envelope"></i> <%= DB_CONFIG["email"] %></a>
        <a href="tel:<%= DB_CONFIG["phone_1"] %>" aria-label="Link to a phone call"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_1"] %></a>
        <a href="tel:<%= DB_CONFIG["phone_2"] %>" aria-label="Link to a phone call"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_2"] %></a>
      </div>
      <div class="header-top-socials">
        <h5 class="text"><%= languageHandler("general.follow_us", current_locale) %>:</h5>
        <a href="<%= DB_CONFIG["facebook"] %>" aria-label="Link to social media platform" target="blank" class="icon facebook"><i class="fab fa-facebook"></i></a>
        <a href="<%= DB_CONFIG["instagram"] %>" aria-label="Link to social media platform" target="blank" class="icon instagram"><i class="fab fa-instagram"></i></a>
        <a href="<%= DB_CONFIG["tiktok"] %>" aria-label="Link to social media platform" target="blank" class="icon tiktok"><i class="fab fa-tiktok"></i></a>
      </div>
      <div class="lang dropdown js-dropdown-opener">
        <button type="button" class="dropdown-link">
          <picture>
            <source srcset="/images/flag-<%= current_locale %>.webp" type="image/webp" />
            <img alt="<%= current_locale %>" loading="lazy" src="images/flag-<%= current_locale %>.png"/>
          </picture>
          <%= current_locale %>
        </button>

        <ul class="dropdown-list js-dropdown-list">
          <% locales.forEach(lang => { %>
            <% if(lang != current_locale) { %>
              <li class="dropdown-list-item">
                <a href="<%= process.env.APP_URL %>/<%= lang %>">
                  <picture>
                    <source srcset="images/flag-<%= lang %>.webp" type="image/webp" />
                    <img alt="<%= lang %>" loading="egaer" src="images/flag-<%= lang %>.png"/>
                  </picture>
                  <%= lang %>
                </a>
              </li>
            <% } %>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

  <div class="header-middle">
    <div class="wrapper">
      <a href="<%= process.env.APP_URL %>/<%= current_locale %>" class="logo" aria-label="<%= process.env.SITE_NAME %> home page link" target="_self">
        <picture>
          <source srcset="images/logo.webp" type="image/webp" />
          <img class="logo-img" loading="lazy" src="images/logo.png" alt="<%= process.env.SITE_NAME %> logo" />
        </picture>
      </a>

      <nav class="nav">
        <ul>
          <li><a target="_self" aria-label="<%= languageHandler("nav.home", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>"><%= languageHandler("nav.home", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.about", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/about"><%= languageHandler("nav.about", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("general.products", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/products"><%= languageHandler("general.products", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.gallery", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/gallery"><%= languageHandler("nav.gallery", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.blog", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/blogs"><%= languageHandler("nav.blog", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.contact", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/contact"><%= languageHandler("nav.contact", current_locale) %></a></li>
        </ul>
      </nav>

      <div class="functions">
        <button class="functions-btn js-cart-btn" type="button"><span class="js-cart-counter">0</span><i class="fas fa-shopping-cart"></i></button>
        <button class="functions-btn js-hamburger-menu" type="button"><i class="fas fa-bars"></i></button>
      </div>
    </div>
  </div>

  <div class="header-bottom">
    <div class="wrapper">
      <div class="header__categories dropdown js-dropdown-opener">
        <div class="header__categories-button">
          <i class="fas fa-list"></i> <%= languageHandler("products.categories", current_locale) %>
        </div>

          <ul class="header__categories-dropdown dropdown-list js-dropdown-list">
            <% webshopCategories.forEach(category => { %>
              <li class="dropdown-list-item">
                <a target="_self" href="<%= process.env.APP_URL %>/<%= current_locale %>/products/category/<%= category.category_slug %>" aria-label="<%= category.name %>" title="<%= category.name %>"><%= category.name %></a>
              </li>
            <% }) %>
          </ul>
      </div>

      <div class="search">
        <input class="search-input js-search-input" type="text" placeholder="<%= languageHandler('general.search', current_locale) %>..." />
        <i style="display: none;" class="fas fa-times search-close js-search-close"></i>
        <button type="button" class="search-btn js-search-btn"><i class="fas fa-search"></i></button>

        <div class="search-results" style="display: none">
          <h4 class="search-results-header"><%= languageHandler('general.results', current_locale) %></h4>
          <div class="loading-spinner"></div>

          <div class="container">
            <header class="container__header">
              <h4 class="container__header-title"><%= languageHandler('general.category', current_locale) %></h4>
            </header>
            <div style="margin-bottom: 20px;">
              <a class="container_box" href="#" aria-label="Link to the selected category">
                <div class="container_box--image">
                  <img src="#" class="icon" alt="Category name" />
                </div>
                <strong class="container_box--title">Category name</strong>
              </a>
            </div>

            <div class="search__not-found" style="margin-bottom: 20px;"><%= languageHandler('products.no_category_like_this') %></div>

            <header class="container__header">
              <h4 class="container__header-title"><%= languageHandler('general.products') %></h4>
            </header>
            <div v-if="searchedProducts?.length > 0">
              <a class="container_box" href="#" aria-label="Link to the selected product">
                <div class="container_box--image">
                  <picture>
                    <source>
                    <img class="img" loading="lazy" src="images/no-picture.jpg" />
                  </picture>
                </div>
                <strong class="container_box--title">{{ product.name }}</strong>
                <h5 class="container_box--category">{{ product.category }}</h5>
            </a>
            </div>

            <div class="search__not-found"><%= languageHandler('products.no_product_like_this') %></div>
          </div>
        </div>
      </div>

      <div class="functions">
        <button
          class="functions-btn js-cart-btn"
          type="button"
        >
          <span class="js-cart-counter"><%= cart.totalCount %></span>
          <i class="fas fa-shopping-cart"></i>
        </button>
      </div>
    </div>
  </div>

  <div class="header-mobile-nav js-mobile-menu">
    <div class="wrapper">
      <div class="close-nav js-close-mobile-menu">
        <i class="fas fa-times"></i>
      </div>

      <div class="langs">
        <div class="langs-item current-lang"><%= current_locale %></div>
        <% locales.forEach(lang => { %>
          <% if (lang != current_locale) { %>
            <a class="langs-item" href="<%= process.env.APP_URL %>/<%= lang %>" target="_self"><%= lang %></a>
          <% } %>
        <% }) %>
      </div>

      <div class="socials">
        <a target="_blank" href="<%= DB_CONFIG["facebook"] %>" aria-label="Link to social media facebook" class="icon facebook"><i class="fab fa-facebook"></i></a>
        <a target="_blank" href="<%= DB_CONFIG["instagram"] %>" aria-label="Link to social media instagram" class="icon instagram"><i class="fab fa-instagram"></i></a>
        <a target="_blank" href="<%= DB_CONFIG["tiktok"] %>" aria-label="Link to social media tiktok" class="icon tiktok"><i class="fab fa-tiktok"></i></a>
      </div>

      <div class="contacts">
        <a href="mailto:<%= DB_CONFIG["email"] %>" aria-label="Link to send a mail"><i class="fas fa-envelope"></i> <%= DB_CONFIG["email"] %></a>
        <a href="tel:<%= DB_CONFIG["phone_1"] %>" aria-label="Link to a phone call"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_1"] %></a>
        <a href="tel:<%= DB_CONFIG["phone_2"] %>" aria-label="Link to a phone call"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_2"] %></a>
      </div>

      <nav class="nav">
        <ul>
          <li><a target="_self" aria-label="<%= languageHandler("nav.home", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>"><%= languageHandler("nav.home", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.about", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/about"><%= languageHandler("nav.about", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("general.products", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/products"><%= languageHandler("general.products", current_locale) %></a></li>

          <li class="js-toggle-container">
            <button
              type="button"
              class="js-slide-toggle nav__categories-button"
            >
              <%= languageHandler("products.categories", current_locale) %>
              <i class="fas fa-chevron-down"></i>
            </button>

            <div class="nav__categories js-toggle-content" style="display: none;">
              <ul>
                <% webshopCategories.forEach(category => { %>
                  <li>
                    <a
                      target="_self"
                      title="<%= category.name %>"
                      aria-label="<%= category.name %>"
                      href="<%= process.env.APP_URL %>/<%= current_locale %>/products/category/<%= category.category_slug %>"
                    >
                      <%= category.name %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            </div>
          </li>

          <li><a target="_self" aria-label="<%= languageHandler("nav.gallery", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/gallery"><%= languageHandler("nav.gallery", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.blog", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/blogs"><%= languageHandler("nav.blog", current_locale) %></a></li>
          <li><a target="_self" aria-label="<%= languageHandler("nav.contact", current_locale) %>" href="<%= process.env.APP_URL %>/<%= current_locale %>/contact"><%= languageHandler("nav.contact", current_locale) %></a></li>
        </ul>
      </nav>
    </div>
  </div>

  <button type="button" class="upscroller js-upscroll"><i class="fas fa-chevron-up"></i></button>
</header>
