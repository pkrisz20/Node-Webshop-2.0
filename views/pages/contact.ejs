<!DOCTYPE html>
<html lang="<%= current_locale %>">
    <%- include('../layout/head.ejs') %>

    <link rel="stylesheet" type="text/css" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css" />
    <link rel="preload" href="css/plugins/slick.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" href="css/contact.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="contact">
            <div class="wrapper">
                <h1 class="main-title"><%= languageHandler('nav.contact', current_locale) %></h1>

                <section class="container">

                    <aside class="container-contacts">
                        <%- include('../components/block-title.ejs', { title: languageHandler('general.contact_datas', current_locale) }) %>

                        <div class="container-contacts-links">
                            <a class="data" aria-label="<%= DB_CONFIG["phone_1"] %>" href="tel:<%= DB_CONFIG["phone_1"] %>"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_1"] %></a>
                            <a class="data" aria-label="<%= DB_CONFIG["phone_2"] %>" href="tel:<%= DB_CONFIG["phone_2"] %>"><i class="fas fa-phone-alt"></i> <%= DB_CONFIG["phone_2"] %></a>
                            <a class="data" aria-label="<%= DB_CONFIG["email"] %>" href="mail:<%= DB_CONFIG["email"] %>"><i class="fas fa-envelope"></i> <%= DB_CONFIG["email"] %></a>
                            <a class="data" aria-label="Link to the map" href="https://www.google.com/maps/place/Tornjo%C5%A1/@45.9117162,19.7342732,11z/data=!4m6!3m5!1s0x4744a53fb7e1f7dd:0x4783b2f37bdb4082!8m2!3d45.8782551!4d19.831876!16s%2Fm%2F02x5v_4?entry=ttu" target="_blank"><i class="fas fa-map-marker-alt"></i> <%= DB_CONFIG["company_street"] %></a>

                            <a href="<%= DB_CONFIG["facebook"] %>" aria-label="Facebook" target="blank" class="data"><i class="fab fa-facebook"></i> Facebook</a>
                            <a href="<%= DB_CONFIG["instagram"] %>" aria-label="Instagram" target="blank" class="data"><i class="fab fa-instagram"></i> Instagram</a>
                            <a href="<%= DB_CONFIG["tiktok"] %>" aria-label="TikTok" target="blank" class="data"><i class="fab fa-tiktok"></i> TikTok</a>
                        </div>
                    </aside>

                    <div class="container-form">
                        <%- include('../components/block-title.ejs', { title: languageHandler('general.contact_title', current_locale), subtitle: languageHandler('general.contact_subtitle', current_locale) }) %>

                        <form class="form js-form-validate" method="post" data-url="<%= process.env.APP_URL %>/<%= current_locale %>/contact/handle">
                            <input
                                id="recaptcha"
                                value="<%= process.env.RECAPTCHA_SITE_KEY %>"
                                name="recaptcha"
                                type="hidden"
                                class="g-recaptcha"
                            />

                            <div class="form-row">
                                <input
                                    id="first-name"
                                    data-rule-required="true"
                                    name="firstName"
                                    type="text"
                                    placeholder="<%= languageHandler('validations.first_name', current_locale) %>"
                                    class="form-control"
                                />
                                <label class="form-label" for="first-name">
                                    <%= languageHandler('validations.first_name', current_locale) %>
                                </label>

                                <i class="error-icon fas fa-times"></i>
                                <div class="form-row-error"></div>
                            </div>

                            <div class="form-row">
                                <input
                                    id="last-name"
                                    data-rule-required="true"
                                    name="lastName"
                                    type="text"
                                    placeholder="<%= languageHandler('validations.last_name', current_locale) %>"
                                    class="form-control"
                                />
                                <label class="form-label" for="last-name">
                                    <%= languageHandler('validations.last_name', current_locale) %>
                                </label>

                                <i class="error-icon fas fa-times"></i>
                                <div class="form-row-error"></div>
                            </div>

                            <div class="form-row">
                                <input
                                    id="contact-phone"
                                    data-rule-required="true"
                                    data-rule-digits="true"
                                    name="phone"
                                    type="text"
                                    placeholder="<%= languageHandler('validations.phone_number', current_locale) %>"
                                    class="form-control"
                                />
                                <label class="form-label" for="contact-phone">
                                    <%= languageHandler('validations.phone_number', current_locale) %>
                                </label>

                                <i class="error-icon fas fa-times"></i>
                                <div class="form-row-error"></div>
                            </div>

                            <div class="form-row">
                                <input
                                    id="contact-email"
                                    data-rule-required="true"
                                    data-rule-email="true"
                                    name="email"
                                    type="email"
                                    placeholder="<%= languageHandler('validations.email', current_locale) %>"
                                    class="form-control"
                                />
                                <label class="form-label" for="contact-email">
                                    <%= languageHandler('validations.email', current_locale) %>
                                </label>

                                <i class="error-icon fas fa-times"></i>
                                <div class="form-row-error"></div>
                            </div>

                            <div class="form-row">
                                <input
                                    id="contact-city"
                                    data-rule-required="true"
                                    name="city"
                                    type="text"
                                    placeholder="<%= languageHandler('validations.city', current_locale) %>"
                                    class="form-control"
                                />
                                <label class="form-label" for="contact-city">
                                    <%= languageHandler('validations.city', current_locale) %>
                                </label>

                                <i class="error-icon fas fa-times"></i>
                                <div class="form-row-error"></div>
                            </div>

                            <div class="form-row">
                                <textarea
                                    id="contact-message"
                                    name="comment"
                                    data-rule-required="true"
                                    data-rule-max-length="1000"
                                    placeholder="<%= languageHandler('validations.message', current_locale) %>"
                                    class="form-control--textarea js-characters-count"
                                    rows="10"
                                    maxlength="1000"></textarea>
                                <label
                                    for="contact-message"
                                    class="form-label form-textarea">
                                    <%= languageHandler('validations.message', current_locale) %>
                                </label>

                                <i class="error-icon textarea-error fas fa-times"></i>
                                <div class="form-row-error"></div>

                                <small class="characters-count js-counter"><span>1000</span> / 1000</small>
                            </div>

                            <div class="form-row gdpr">
                                <label
                                    class="form-label"
                                    for="data-handling">
                                    <%= languageHandler('validations.accept_policy', current_locale) %>

                                    <input
                                        id="data-handling"
                                        name="accept"
                                        type="checkbox"
                                        checked="checked"
                                        class="form-row-checkbox"
                                    />
                                    <span class="checkmark"></span>
                                </label>
                                <span class="gdpr-details"><%= languageHandler('general.details_here', current_locale) %>: <a href="<%= process.env.APP_URL %>/<%= current_locale %>/policy"><%= languageHandler('nav.privacy_policy', current_locale) %></a></span>
                            </div>

                            <button type="submit" class="form-submit"><i class="fas fa-paper-plane"></i> <%= languageHandler('validations.send', current_locale) %></button>
                        </form>
                    </div>
                </section>
            </div>

            <section class="contact-map">
                <div style="width: 100%; height: 450px; z-index: 30;" id="map"></div>
            </section>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <script type="text/javascript">
        var locale = <%- JSON.stringify(current_locale) %>;
    </script>
    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <script src="https://www.google.com/recaptcha/api.js?render=<%= process.env.RECAPTCHA_SITE_KEY %>"></script>
    <script type="text/javascript" src="js/plugins/validate.min.js"></script>

    <% if (current_locale != 'en') { %>
        <script type="text/javascript" src="js/plugins/validator_messages_<%= current_locale %>.js"></script>
    <% } %>

    <script type="text/javascript" src="js/main.js"></script>

    <script src="https://js.api.here.com/v3/3.1/mapsjs-core.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-service.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-ui.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js"></script>
    <script type="text/javascript">
        var platform = new H.service.Platform({
            apikey: 'BbrImBFdudPWuw_p4_-YDUzsq1ZzwhpZjqbuEtAD6AA'
        });
        var defaultLayers = platform.createDefaultLayers();

        var map = new H.Map(document.getElementById('map'),
        defaultLayers.vector.normal.map, {
            center: { lat: 45.878360927128206, lng: 19.832637565189028 },
            zoom: 11,
            pixelRatio: window.devicePixelRatio || 1
        });

        var cityMarker = new H.map.Marker({ lat: 45.878360927128206, lng: 19.832637565189028 });
        map.addObject(cityMarker);

        window.addEventListener('resize', function () {
            map.getViewPort().resize();
        });

        var mapEvents = new H.mapevents.MapEvents(map);
        var behavior = new H.mapevents.Behavior(mapEvents);
    </script>
</body>
</html>
