<!DOCTYPE html>
<html lang="<%= meta.lang %>">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="css/plugins/slick.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />

    <% if (blogDetails.images.length > 0) { %>
        <link rel="preload" href="css/plugins/lightbox.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <% } %>

    <link rel="preload" href="css/blog-details.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="blog-details">
            <section class="blog-details-section">
                <div class="wrapper">
                    <h1 class="main-title"><%= blogDetails.title %></h1>

                    <div class="blog-container">
                        <article class="blog-article <%= nextEvents.length > 0 ? 'has-sidebar' : '' %>">
                            <header class="blog-article__header">
                                <time class="blog-article__date"><%= blogDetails.date %></time>
                                <strong class="blog-article__author"><%= blogDetails.author %></strong>
                            </header>
                            <div class="blog-thumbnail <%= blogDetails.images.length > 0 ? 'icon--hover js-gallery-thumb' : ''%>">
                                <i class="fas fa-search-plus search-icon"></i>
                                <picture>
                                    <source srcset="<%= blogDetails.thumb_image %>">
                                    <img loading="lazy" src="<%= process.env.APP_URL %>/images/no-picture.jpg" alt="<%= blogDetails.title %>" />
                                </picture>
                            </div>

                            <% if (blogDetails.images.length > 0) { %>
                                <div class="blog-article__thumbs js-gallery">
                                    <div class="hide" data-src="<%= blogDetails.thumb_image %>">
                                        <img src="<%= blogDetails.thumb_image %>" alt="<%= blogDetails.title %> thumbnail">
                                    </div>
                                    <% blogDetails.images.forEach((image, index) => { %>
                                        <div class="icon--hover" data-src="<%= image %>">
                                            <i class="fas fa-search-plus search-icon"></i>

                                            <img src="<%= image %>" alt="<%= blogDetails.title %> #<%= index + 1 %>" />
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="ck-content">
                                <%- blogDetails.description %>
                            </div>

                            <%- include('../components/sharing-buttons.ejs', { page_url: `blog/${ blogDetails.slug }`, mail_subject: blogDetails.title }) %>
                        </article>

                        <% if (nextEvents.length > 0) { %>
                            <aside class="blog-aside">
                                <%- include('../components/block-title.ejs', { title: languageHandler('general.next_events', current_locale) }) %>

                                <% nextEvents.forEach((event, index) => { %>
                                    <a class="blog-aside-article" href="<%= process.env.APP_URL %>/<%= current_locale %>/blog/<%= event.slug %>" title="<%= event.title %>" aria-label="<%= event.title %>">
                                        <div class="blog-aside-article-image">
                                            <picture>
                                                <source srcset="<%= event.image %>">
                                                <img loading="lazy" src="<%= process.env.APP_URL %>/images/no-picture.jpg" alt="<%= event.title %>" />
                                            </picture>
                                        </div>

                                        <div class="texts">
                                            <h3 class="texts-title"><%= event.title %></h3>
                                            <time class="texts-time"><i class="fas fa-history"></i> <%= event.date %></time>
                                        </div>
                                    </a>
                                <% }) %>
                            </aside>
                        <% } %>
                    </div>
                </div>
            </section>

            <% if (blogDetails.isAllowed) { %>
                <%- include('../components/comments.ejs', { itemId: blogDetails.id, articleType: "blog" }) %>
            <% } %>

            <% if (newestBlogs.length > 0) { %>
                <section class="featured-blogs">
                    <div class="wrapper">
                        <%- include('../components/block-title.ejs', { title: languageHandler('general.newest_blogs', current_locale) }) %>

                        <div class="js-featured-blogs">
                            <% newestBlogs.forEach(item => { %>
                                <div class="slide">
                                    <%- include("../components/blog-card.ejs", { blog: item }) %>
                                </div>
                            <% }) %>
                        </div>

                        <% if (newestBlogs.length > 1) { %>
                            <button type="button" class="slick-prev slick-arrow"><i class="fas fa-chevron-left"></i></button>
                            <button type="button" class="slick-next slick-arrow"><i class="fas fa-chevron-right"></i></button>
                        <% } %>
                    </div>
                </section>
            <% } %>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <% if (process.env.GDPR_ENABLED || false) { %>
        <%- include('../components/cookie-panel') %>
    <% } %>

    <script type="text/javascript">
        var locale = <%- JSON.stringify(current_locale) %>;
    </script>
    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/slick.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <% if (blogDetails.images.length > 0) { %>
        <script type="text/javascript" src="js/plugins/lightbox.min.js"></script>
    <% } %>

    <% if (blogDetails.isAllowed) { %>
        <script src="https://www.google.com/recaptcha/api.js?render=<%= process.env.RECAPTCHA_SITE_KEY %>"></script>
        <script type="text/javascript" src="js/plugins/validate.min.js"></script>
    <% } %>

    <% if (current_locale != 'en' && blogDetails.isAllowed) { %>
        <script type="text/javascript" src="js/plugins/validator_messages_<%= current_locale %>.js"></script>
    <% } %>

    <% if (blogDetails.isAllowed && showLoadMoreButton) { %>
        <script type="text/javascript">
            $('body').on('click', '.js-load-more-comments', function () {
                var this_button = $(this);
                var offsetNum = this_button.data('offset');
                var articleID = this_button.data('article');

                $.ajax({
                    type: "POST",
                    url: `/${ locale }/blog/comment/load-more`,
                    dataType: 'json',
                    data: {
                        offsetNumber: offsetNum,
                        blogID: articleID,
                        _csrf: $("meta[name='csrf-token']").attr("content")
                    },
                    beforeSend: function (jqXHR) {
                        this_button.addClass('disabled').attr('disabled', 'disabled').prop('disabled', true);
                    },
                    complete: function (jqXHR, textStatus) {
                        this_button.removeClass('disabled').removeAttr('disabled').prop('disabled', false);
                    },
                    success: function (response) {
                        // Set the new XSRF token
                        if (typeof response.csrfToken !== 'undefined') {
                            $("meta[name='csrf-token']").attr("content", response.csrfToken);
                        }

                        if (response.status === 'success') {
                            $('body .js-comments-container').append(response.html_response_with_comments);

                            if ( response.removeLoadButton ) {
                                this_button.remove();
                            }
                            else if ( !response.removeLoadButton && response.offsetNumber ) {
                                this_button.data('offset', response.offsetNumber);
                            }
                        }

                        else if (response.status === 'error') {
                            $.alert({
                                useBootstrap: false,
                                boxWidth: '400px',
                                title: response.title,
                                content: response.message || false,
                                buttons: {
                                    OK: function () {
                                        // do nothing, and close modal
                                    }
                                }
                            });
                        }
                    }
                });
            });
        </script>
    <% } %>

    <% if (blogDetails.images.length > 0) { %>
        <script type="text/javascript">
            var gallery = $('.js-gallery div').simpleLightbox({
                focus: false,
                doubleTapZoom: 2,
                maxZoom: 6,
                loop: true,
                showCounter: true,
                sourceAttr: 'data-src'
            });

            $('body').on('click', '.js-gallery-thumb', function () {
                gallery.open();
            });
        </script>
    <% } %>

    <script type="text/javascript" src="js/main.js"></script>
</body>
</html>
