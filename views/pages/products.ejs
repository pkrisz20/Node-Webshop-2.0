<!DOCTYPE html>
<html lang="<%= meta.lang %>">
    <%- include('../layout/head.ejs') %>

    <link rel="canonical" href="<%= process.env.APP_URL %>/<%= current_locale %>/products" />
    <link rel="preload" href="css/product-list.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="list">
            <div class="wrapper">
                <h1 class="main-title"><%= main_title %></h1>

                <% if (category_short_desc) { %>
                    <p class="list__shorts"><%= category_short_desc %></p>
                <% } %>

                <section class="listpage products">
                    <% if (productsTotalCount > 0) { %>
                        <strong class="listpage__total-count"><%= productsTotalCount %> <%= languageHandler('general.product', current_locale) %></strong>
                    <% } %>

                    <% if (products.length > 0) { %>
                        <div class="listpage-container">
                            <% products.forEach(product => { %>
                                <%- include("../components/product-card.ejs", { product: product }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="system-info">
                            <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_product_like_this', current_locale) %></strong>
                        </div>
                    <% } %>
                </section>

                <% if (pageCount > 1) { %>
                    <%- include('../layout/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, link: articleLink }) %>
                <% } %>
            </div>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <script type="text/javascript">
        var locale = <%- JSON.stringify(current_locale) %>;
    </script>
    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <script type="text/javascript" src="js/main.js"></script>
</body>
</html>
