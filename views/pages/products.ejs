<!DOCTYPE html>
<html lang="<%= current_locale %>">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="css/product-list.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="list">
            <div class="wrapper">
                <h1 class="main-title"><%= main_title %></h1>

                <section class="listpage products">
                    <% if (products.length > 0) { %>
                        <div class="listpage-container">
                            <% products.forEach(product => { %>
                                <%- include("../components/product-card.ejs", { product: product }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="listpage-info">
                            <strong class="listpage-info-no-content"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_product_like_this', current_locale) %></strong>
                        </div>
                    <% } %>
                </section>

                <% if (pageCount > 1) { %>
                    <%- include('../layout/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, link: articleLink }) %>
                <% } %>
            </div>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/slick.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <script type="text/javascript" src="js/main.js"></script>
</body>
</html>
