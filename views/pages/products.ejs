<%- extend('layouts/base') %>

<%- push('styles') %>
    <link rel="preload" href="<%= getAssetPath('/css/plugins/jquery-ui.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" href="<%= getAssetPath('/css/product-list.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<%- endPush() %>

<%- section('content') %>
    <%- include('../components/breadcrumbs.ejs', { currentLinkName: main_title }) %>

    <main class="list">

        <div class="wrapper">
            <h1 class="main-title"><%= main_title %></h1>

            <% if (category_short_desc) { %>
                <p class="list__shorts"><%= category_short_desc %></p>
            <% } %>

            <div class="list__data" data-anchor="products-list">
                <%- include('../components/product-filters', { webshopFilters: webshopFilters }) %>

                <section class="listpage products">
                    <button type="button" class="filter__trigger js-open-filters-sidebar">
                        <i class="fas fa-sliders-h"></i>
                        <%= languageHandler('products.filters', current_locale) %>
                    </button>

                    <div class="listpage__options">
                        <% if (productsTotalCount > 0) { %>
                            <strong class="listpage__total-count js-total-products"><%= productsTotalCount %> <%= languageHandler('general.product', current_locale) %></strong>
                        <% } %>

                        <div class="listpage__options-dropdowns">
                            <select class="js-watch-option">
                                <option selected="selected" value="deafult"><%= languageHandler('products_sorting.default', current_locale) %></option>
                                <% validSortOptions.forEach(option => { %>
                                    <option value="<%= option %>"><%= languageHandler('products_sorting.' + option, current_locale) %></option>
                                <% }) %>
                            </select>
                            <select class="js-watch-option">
                                <% validLimitValues.forEach(limitValue => { %>
                                    <option value="<%= limitValue %>"><%= limitValue %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>


                    <% if (products.length > 0) { %>
                        <div class="listpage-container js-product-list">
                            <% products.forEach(product => { %>
                                <%- include("../components/product-card.ejs", { product: product }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="system-info">
                            <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_product_like_this', current_locale) %></strong>
                        </div>
                    <% } %>

                    <% if (pageCount > 1) { %>
                        <%- include('../partials/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, link: paginationPath, customPaginationClass: 'js-pagination-wrapper' }) %>
                    <% } %>
                </section>
            </div>
        </div>
    </main>
<%- endSection() %>

<%- push('plugins') %>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jquery.ui.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jquery.ui.touch-punch.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/block.ui.min.js') %>"></script>
<%- endPush() %>

<%- push('scripts') %>
    <script type="text/javascript" src="<%= getAssetPath('/js/product-list.js') %>"></script>
<%- endPush() %>
