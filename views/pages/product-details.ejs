<!DOCTYPE html>
<html lang="<%= current_locale %>">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="css/plugins/slick.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="css/plugins/lightbox.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="css/product-details.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="product-details">
            <div class="wrapper">

                <section class="product-details-section">
                    <h1 class="main-title"><%= productDetails.name %></h1>

                    <div class="details">
                        <div class="details-gallery js-gallery-thumb">
                            <picture>
                                <source srcset="<%= productDetails.thumbnailImage %>" />
                                <img class="details-thumbnail" loading="lazy" src="/images/no-picture.jpg">
                            </picture>
                        </div>

                        <% if (productDetails.images.length > 0) { %>
                            <div class="js-gallery hide">
                                <div data-src="<%= productDetails.thumbnailImage %>">
                                    <img src="<%= productDetails.thumbnailImage %>" alt="Image thumbnail">
                                </div>
                                <% productDetails.images.forEach((image, index) => { %>
                                    <div data-src="<%= image %>">
                                        <img src="<%= image %>" alt="<%= `Image ${ index }` %>">
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>

                        <div class="details-desc">
                            <div class="details-desc-active <%= productDetails.isAvailable ? 'green' : 'red' %>">
                                <% if (productDetails.isAvailable) { %>
                                    <i class="fas fa-check-circle"></i>
                                <% } else if (!productDetails.isAvailable) { %>
                                    <i class="fas fa-times-circle"></i>
                                <% } %>
                                <%= productDetails.isAvailable ? languageHandler('products.available', current_locale) : languageHandler('products.out_of_stock', current_locale) %>
                            </div>

                            <div class="details-desc-active <%= productDetails.isPostable ? 'yellow' : 'black'%>">
                                <% if (productDetails.isPostable) { %>
                                    <i class="fas fa-truck"></i>
                                <% } else if (!productDetails.isPostable) { %>
                                    <i class="fas fa-exclamation-circle"></i>
                                <% } %>
                                <%= productDetails.isPostable ? languageHandler('products.postable', current_locale) : languageHandler('products.not_postable', current_locale) %>
                            </div>

                            <strong class="details-desc-price"><%= productDetails.isOnDiscount ? productDetails.discount : productDetails.price %> <small>RSD</small></strong>
                            <% if (productDetails.isOnDiscount) { %>
                                <del class="details-desc-discount-price"><%= productDetails.price %> RSD</del>
                            <% } %>

                            <div class="details-desc-functions">

                                <% if (productDetails.isAvailable && !isAlreadyInCart) { %>
                                    <div class="quantities js-quantities">
                                        <button type="button" class="quantities-btn minus js-details-quantity-btn"><i class="fas fa-minus"></i></button>
                                        <input class="quantities-input js-product-details-quantity" value="1" type="number" min="1" max="<%= productDetails.maxQuantity %>" />
                                        <button type="button" class="quantities-btn plus js-details-quantity-btn"><i class="fas fa-plus"></i></button>
                                    </div>
                                <% } %>

                                <% if (isAlreadyInCart) { %>
                                    <div class="added-cart"><i class="fas fa-coins"></i><%= languageHandler('orders.already_added', current_locale) %></div>
                                <% } %>

                                <% if (productDetails.isAvailable && !isAlreadyInCart) { %>
                                    <button class="details-desc-functions-cart js-add-to-cart" type="button" data-id="<%= productDetails.id %>"><i class="fas fa-shopping-cart"></i> <%= languageHandler('products.add_cart', current_locale) %></button>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <% if (productDetails.description) { %>
                        <p class="paragraph"><%= productDetails.description %></p>
                    <% } %>
                </section>

                <% if (productDetails.isAllowed) { %>
                    <%- include('../components/comments.ejs', { itemId: productDetails.id, articleType: "product" }) %>
                <% } %>

                <% if (similarProducts.length > 0) { %>
                    <section class="products-carousel">
                        <%- include('../components/block-title.ejs', { title: languageHandler('products.similar_products', current_locale) }) %>

                        <div class="js-featured-products">
                            <% similarProducts.forEach(item => { %>
                                <div class="slide">
                                    <%- include("../components/product-card.ejs", { product: item }) %>
                                </div>
                            <% }) %>
                        </div>

                        <% if (similarProducts.length > 1) { %>
                            <button type="button" class="slick-prev slick-arrow"><i class="fas fa-chevron-left"></i></button>
                            <button type="button" class="slick-next slick-arrow"><i class="fas fa-chevron-right"></i></button>
                        <% } %>
                    </section>
                <% } %>
            </div>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/slick.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <script type="text/javascript" src="js/plugins/lightbox.min.js"></script>
    <script type="text/javascript" src="js/main.js"></script>
    <% if (productDetails.isAllowed) { %>
        <script type="text/javascript" src="js/comments.js"></script>
    <% } %>
    <script type="text/javascript">
        $('body').on("click", ".js-details-quantity-btn", function (event) {
            event.preventDefault();
            var quantity_wrapper = $(this).closest('.js-quantities');
            var quantity = quantity_wrapper.find('.js-product-details-quantity');
            var value = parseInt(quantity.val());

            if ( $(this).hasClass('minus') && value > 1 ) {
                value = value - 1;
            }
            else if ( $(this).hasClass('plus') ) {
                value = value + 1;
            }

            quantity.val(value);
        });

        $('body').on("change", ".js-product-details-quantity", function (event) {
            event.preventDefault();
            var this_button = $('.js-details-quantity-btn');
            var quantity = null;
            quantity = $(event.target).val();
            quantity = parseInt(quantity);
        });
    </script>
    <% if (productDetails.images.length > 0) { %>
        <script type="text/javascript">
            var gallery = $('.js-gallery div').simpleLightbox({
                focus: false,
                doubleTapZoom: 2,
                maxZoom: 6,
                loop: true,
                showCounter: true,
                sourceAttr:'data-src'
            });

            $('body').on('click', '.js-gallery-thumb', function () {
                gallery.open();
            });
        </script>
    <% } %>
</body>
</html>
