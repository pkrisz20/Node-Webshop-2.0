<!DOCTYPE html>
<html lang="<%= meta.lang %>">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="<%= getAssetPath('/css/about.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="about">
            <div class="wrapper">
                <h1 class="main-title"><%= languageHandler('nav.about', current_locale) %></h1>

                <% if (employees.length > 0) { %>
                    <section class="about-content">
                        <% if (pageData.shortDesc) { %>
                            <div class="about-short">
                                <p class="about-short-text"><%= pageData.shortDesc %></p>
                            </div>
                        <% } %>

                        <%- include('../components/block-title.ejs', { title: languageHandler('about.our_workers', current_locale), subtitle: languageHandler('about.our_workers_subtitle', current_locale), centerTitle: true }) %>

                        <div class="workers">
                            <% employees.forEach(employee => { %>
                                <div class="workers-container">
                                    <figure class="workers-container-box">

                                        <%- include('../components/picture.ejs', {
                                            imageSrc: employee.image,
                                            alt: employee.name + " - " + employee.position
                                        }) %>

                                        <figcaption>
                                            <h3 class="workers-container-name"><%= employee.name %></h3>
                                            <h4 class="workers-container-position"><%= employee.position %></h4>
                                        </figcaption>
                                    </figure>
                                    <div class="workers-container-contacts">
                                        <% if (employee.contact.facebook) { %>
                                            <a title="Facebook" href="<%= employee.contact.facebook %>" target="blank" aria-label="Link to Facebook"><i class="fab fa-facebook"></i></a>
                                        <% } %>

                                        <% if (employee.contact.tiktok) { %>
                                            <a title="TikTok" href="<%= employee.contact.tiktok %>" target="blank" aria-label="Link to TikTok"><i class="fab fa-tiktok"></i></a>
                                        <% } %>

                                        <% if (employee.contact.instagram) { %>
                                            <a title="Instagram" href="<%= employee.contact.instagram %>" target="blank" aria-label="Link to Instagram"><i class="fab fa-instagram"></i></a>
                                        <% } %>

                                        <% if (employee.contact.email) { %>
                                            <a title="E-mail" href="mailto:<%= employee.contact.email %>" aria-label="Link to Email sending"><i class="fas fa-envelope"></i></a>
                                        <% } %>

                                        <% if (employee.contact.phone) { %>
                                            <a title="Phone" href="tel:<%= employee.contact.phone %>" aria-label="Link to phone call"><i class="fas fa-phone-alt"></i></a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

                <% if (pageData.longDesc) { %>
                    <section class="about-long">
                        <%- include('../components/block-title.ejs', { title: languageHandler('about.our_story', current_locale), subtitle: languageHandler('about.our_story_subtitle', current_locale), centerTitle: true }) %>

                        <article class="ck-content">
                            <%- pageData.longDesc %>
                        </article>
                    </section>
                <% } %>
            </div>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <% if (process.env.GDPR_ENABLED || false) { %>
        <%- include('../components/cookie-panel') %>
    <% } %>
    <script type="text/javascript">
        var locale = <%- JSON.stringify(current_locale) %>;
    </script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/main.js') %>"></script>
</body>
</html>
