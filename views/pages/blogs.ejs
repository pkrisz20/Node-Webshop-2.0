<%- extend('layouts/base') %>

<%- push('styles') %>
    <link rel="preload" href="<%= getAssetPath('/css/blog-list.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<%- endPush() %>

<%- section('content') %>
    <%- include('../components/breadcrumbs.ejs', { currentLinkName: languageHandler('nav.blog', current_locale) }) %>

    <main class="list">
        <div class="wrapper">
            <h1 class="main-title"><%= languageHandler('nav.blog', current_locale) %></h1>

            <section class="listpage blogs">
                <% if (blogs.length > 0) { %>
                    <div class="listpage-container">
                        <% blogs.forEach(blog => { %>
                            <%- include("../components/blog-card.ejs", { blog: blog }) %>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="system-info">
                        <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_blogs_like_this', current_locale) %></strong>
                    </div>
                <% } %>
            </section>

            <% if (pageCount > 1) { %>
                <%- include('../partials/pagination.ejs', { pageCount: pageCount, currentPage: currentPage, link: paginationPath }) %>
            <% } %>
        </div>
    </main>
<%- endSection() %>
