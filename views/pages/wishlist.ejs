<%- extend('layouts/base') %>

<%- push('styles') %>
    <link rel="stylesheet" href="<%= getAssetPath('/css/product-list.css') %>" />
<%- endPush() %>

<%- section('content') %>
    <%- include('../components/breadcrumbs.ejs', { currentLinkName: languageHandler('general.wishlist', current_locale) }) %>

    <main class="list">
        <div class="wrapper">
            <h1 class="main-title"><%= languageHandler('general.wishlist', current_locale) %></h1>

            <section class="listpage products">
                <% if (wishlistTotalNumber > 0) { %>
                    <strong class="listpage__total-count"><%= wishlistTotalNumber %> <%= languageHandler('general.product', current_locale) %></strong>
                <% } %>

                <% if (wishlistProducts.length > 0) { %>
                    <div class="listpage-container">
                        <% wishlistProducts.forEach(product => { %>
                            <%- include("../components/product-card.ejs", { product: product }) %>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="system-info">
                        <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('general.no_items_in_wishlist', current_locale) %></strong>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
<%- endSection() %>
