<!DOCTYPE html>
<html lang="<%= meta.lang %>">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="<%= getAssetPath('/css/product-list.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <%- include('../components/breadcrumbs.ejs', { currentLinkName: languageHandler('general.wishlist', current_locale) }) %>

        <main class="list">
            <div class="wrapper">
                <h1 class="main-title"><%= languageHandler('general.wishlist', current_locale) %></h1>

                <section class="listpage products">
                    <% if (wishlistTotalNumber > 0) { %>
                        <strong class="listpage__total-count"><%= wishlistTotalNumber %> <%= languageHandler('general.product', current_locale) %></strong>
                    <% } %>

                    <% if (wishlistProducts.length > 0) { %>
                        <div class="listpage-container">
                            <% wishlistProducts.forEach(product => { %>
                                <%- include("../components/product-card.ejs", { product: product }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="system-info">
                            <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('general.no_items_in_wishlist', current_locale) %></strong>
                        </div>
                    <% } %>
                </section>
            </div>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <% if (process.env.GDPR_ENABLED || false) { %>
        <%- include('../components/cookie-panel') %>
    <% } %>

    <script type="text/javascript">
        var locale = <%- JSON.stringify(current_locale) %>;
    </script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jquery.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/jconfirm.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/main.js') %>"></script>
</body>
</html>
