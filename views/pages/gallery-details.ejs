<%- extend('layouts/base') %>

<%- push('styles') %>
    <link rel="stylesheet" href="<%= getAssetPath('/css/plugins/lightbox.min.css') %>" />
    <link rel="stylesheet" href="<%= getAssetPath('/css/plugins/slick.min.css') %>" />
    <link rel="stylesheet" href="<%= getAssetPath('/css/gallery-details.css') %>" />
<%- endPush() %>

<%- section('content') %>
    <%- include('../components/breadcrumbs.ejs', {
        currentLinkName: galleryData.galleryName,
        previousLinkName: languageHandler('nav.gallery', current_locale),
        previousLink: languageHandler('slugs.galleries', current_locale)
    }) %>

    <main class="gallery-details">
        <div class="wrapper">
            <header class="page-header gallery-details-header">
                <time class="gallery-details-date"><i class="far fa-calendar-alt"></i> <%= galleryData.date %></time>
                <h1 class="main-title"><%= galleryData.galleryName %></h1>

                <% if (galleryData.description) { %>
                    <p class="gallery-details-desc"><%= galleryData.description %></p>
                <% } %>
            </header>

            <section class="<%= (galleryData.galleryImages && galleryData.galleryImages.length > 0) ? 'gallery-grid js-gallery' : '' %>">
                <% if (galleryData.galleryImages && galleryData.galleryImages.length > 0) { %>
                    <% galleryData.galleryImages.forEach((image, index) => { %>
                        <figure class="gallery-grid-item" data-src="<%= image %>">
                            <figcaption class="icon">
                                <i class="far fa-eye"></i>
                            </figcaption>

                            <%- include('../components/picture.ejs', {
                                imageSrc: image,
                                alt: galleryData.galleryName + " #" + (index + 1),
                            }) %>
                        </figure>
                    <% }) %>
                <% } else if (!galleryData.galleryImages || galleryData.galleryImages.length === 0) { %>
                    <div class="system-info">
                        <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_images_in_this_gallery', current_locale) %></strong>
                    </div>
                <% } %>
            </section>

            <%- include('../components/sharing-buttons.ejs', { page_url: languageHandler('slugs.gallery', current_locale) + "/" + galleryData.slug + "/" + galleryData.id, mail_subject: galleryData.galleryName }) %>
        </div>

        <% if (relatedGalleries.length > 0) { %>
            <section class="featured-galleries">
                <div class="wrapper">
                    <div class="section-head">
                        <%- include('../components/block-title.ejs', { title: languageHandler('general.related_galleries', current_locale) }) %>

                        <% if (relatedGalleries.length > 1) { %>
                            <div class="section-head__arrows">
                                <button type="button" class="slick-prev slick-arrow" aria-label="<%= languageHandler('general.prev_page', current_locale) %>" title="<%= languageHandler('general.prev_page', current_locale) %>"><i class="fas fa-arrow-left"></i></button>
                                <button type="button" class="slick-next slick-arrow" aria-label="<%= languageHandler('general.next_page', current_locale) %>" title="<%= languageHandler('general.next_page', current_locale) %>"><i class="fas fa-arrow-right"></i></button>
                            </div>
                        <% } %>
                    </div>

                    <div class="js-featured-galleries">
                        <% relatedGalleries.forEach(item => { %>
                            <div class="slide">
                                <%- include("../components/gallery-card.ejs", { galleryItem: item }) %>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>
    </main>
<%- endSection() %>

<%- push('plugins') %>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/slick.min.js') %>"></script>
    <script type="text/javascript" src="<%= getAssetPath('/js/plugins/lightbox.min.js') %>"></script>
<%- endPush() %>

<%- push('scripts') %>
    <script type="text/javascript">
        var gallery = $('.js-gallery figure').simpleLightbox({
            focus: false,
            doubleTapZoom: 2,
            maxZoom: 6,
            loop: true,
            showCounter: true,
            sourceAttr:'data-src'
        });
    </script>
<%- endPush() %>
