<!DOCTYPE html>
<html lang="<%= current_locale %>">
    <%- include('../layout/head.ejs') %>

    <link rel="preload" href="css/plugins/slick.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" href="css/search-list.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
</head>

<body>
    <div class="site-wrap">
        <%- include('../layout/header.ejs') %>

        <%- include('../components/cart.ejs') %>

        <main class="search-list">
            <div class="wrapper">
                <h1 class="main-title"><%= languageHandler('general.results_for', current_locale) %>: <%= keywords %></h1>

                <section class="search-list-listpage">
                    <%- include('../components/block-title.ejs', { title: languageHandler('general.products', current_locale) }) %>

                    <% if (productsFound.results.length > 0) { %>
                        <small class="search-list-listpage--counter"><%= productsFound.count %> <%= languageHandler('general.result', current_locale) %></small>
                        <div class="container">
                            <% productsFound.results.forEach(product => { %>
                                <%- include("../components/product-card.ejs", { product: product }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="system-info">
                            <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_product_like_this', current_locale) %></strong>
                        </div>
                    <% } %>
                </section>

                <section class="search-list-listpage">
                    <%- include('../components/block-title.ejs', { title: languageHandler('nav.blog', current_locale) }) %>

                    <% if (blogsFound.results.length > 0) { %>
                        <small class="search-list-listpage--counter"><%= blogsFound.count %> <%= languageHandler('general.result', current_locale) %></small>
                        <div class="container">
                            <% blogsFound.results.forEach(blog => { %>
                                <%- include("../components/blog-card.ejs", { blog: blog }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="system-info">
                            <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_blogs_like_this', current_locale) %></strong>
                        </div>
                    <% } %>
                </section>

                <section class="search-list-listpage">
                    <%- include('../components/block-title.ejs', { title: languageHandler('general.gallery', current_locale) }) %>

                    <% if (galleryFound.results.length > 0) { %>
                        <small class="search-list-listpage--counter"><%= galleryFound.count %> <%= languageHandler('general.result', current_locale) %></small>
                        <div class="container gallery">
                            <% galleryFound.results.forEach(gallery => { %>
                                <%- include("../components/gallery-card.ejs", { galleryItem: gallery }) %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="system-info">
                            <strong class="system-info-text"><i class="fas fa-info-circle"></i><%= languageHandler('products.no_gallery_like_this', current_locale) %></strong>
                        </div>
                    <% } %>
                </section>
            </div>
        </main>

        <%- include('../layout/footer.ejs') %>
    </div>

    <script type="text/javascript" src="js/plugins/jquery.min.js"></script>
    <script type="text/javascript" src="js/plugins/slick.min.js"></script>
    <script type="text/javascript" src="js/plugins/jconfirm.min.js"></script>
    <script type="text/javascript" src="js/main.js"></script>
</body>
</html>
