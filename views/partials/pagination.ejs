<% if (pageCount > 1) { %>
    <% const radius = config.pagination.pageLinkRadius; %>

    <nav class="pagination <%= locals.customPaginationClass ? locals.customPaginationClass : '' %>">
        <ul class="pagination-list">
            <% if (currentPage > 1) { %>
                <li class="pagination-item arrow prev-arrow">
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= link %>?page=<%= currentPage - 1 %>"><i class="fas fa-chevron-left"></i> <%= languageHandler('general.prev_page', current_locale) %></a>
                </li>
            <% } %>

            <% if (currentPage > radius + 1) { %>
                <li class="pagination-item">
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= link %>?page=1">1</a>
                </li>
                <% if (currentPage > radius + 2) { %>
                    <li class="pagination-item disabled">
                        <span>...</span>
                    </li>
                <% } %>
            <% } %>

            <%
                const startPage = Math.max(1, currentPage - radius);
                const endPage = Math.min(pageCount, currentPage + radius);
            %>

            <% for (var index = startPage; index <= endPage; index++) { %>
                <li class="pagination-item <%= currentPage == index ? 'active' : '' %>">
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= link %>?page=<%= index %>"><%= index %></a>
                </li>
            <% } %>

            <% if (currentPage < pageCount - radius) { %>
                <% if (currentPage < pageCount - radius - 1) { %>
                    <li class="pagination-item disabled">
                        <span>...</span>
                    </li>
                <% } %>
                <li class="pagination-item">
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= link %>?page=<%= pageCount %>"><%= pageCount %></a>
                </li>
            <% } %>

            <% if (currentPage < pageCount) { %>
                <li class="pagination-item arrow next-arrow">
                    <a href="<%= process.env.APP_URL %>/<%= current_locale %>/<%= link %>?page=<%= currentPage + 1 %>"><%= languageHandler('general.next_page', current_locale) %> <i class="fas fa-chevron-right"></i></a>
                </li>
            <% } %>
        </ul>
    </nav>
<% } %>
