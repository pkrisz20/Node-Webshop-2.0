<%
    const footerHome = process.env.APP_URL + '/' + current_locale;
    const footerPage = slugKey => footerHome + '/' + languageHandler(slugKey, current_locale);
    const footerContentPage = name => footerHome + '/' + languageHandler('slugs.content', current_locale) + '/' + staticContent[name]['slug'];
    const footerHasSocials = DB_CONFIG["facebook"] || DB_CONFIG["instagram"] || DB_CONFIG["tiktok"];
%>
<footer class="footer">
    <div class="footer-main">
        <div class="wrapper footer-main__grid">
            <div class="footer-brand">
                <a class="footer-logo" target="_self" href="<%= footerHome %>" aria-label="<%= process.env.SITE_NAME %> home page link">
                    <%- include('../components/picture.ejs', {
                        imageURL: true,
                        imgClass: "logo-img",
                        webpImage: getAssetPath('/images/logo.webp'),
                        imageSrc: getAssetPath('/images/logo.png'),
                        alt: process.env.SITE_NAME + " footer logo",
                    }) %>
                </a>

                <% if (DB_CONFIG["home_page_text"]) { %>
                    <p class="footer-brand__text"><%= DB_CONFIG["home_page_text"] %></p>
                <% } %>

                <% if (footerHasSocials) { %>
                    <div class="footer-socials">
                        <% if (DB_CONFIG["facebook"]) { %>
                            <a href="<%= DB_CONFIG["facebook"] %>" aria-label="Facebook" title="Facebook" target="_blank" rel="noopener"><i class="fab fa-facebook-f"></i></a>
                        <% } %>
                        <% if (DB_CONFIG["instagram"]) { %>
                            <a href="<%= DB_CONFIG["instagram"] %>" aria-label="Instagram" title="Instagram" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
                        <% } %>
                        <% if (DB_CONFIG["tiktok"]) { %>
                            <a href="<%= DB_CONFIG["tiktok"] %>" aria-label="TikTok" title="TikTok" target="_blank" rel="noopener"><i class="fab fa-tiktok"></i></a>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <div class="footer-col">
                <h3 class="footer-title"><%= languageHandler('nav.quick_links', current_locale) %></h3>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.about_us') %>"><%= languageHandler('nav.about', current_locale) %></a>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.products') %>"><%= languageHandler('general.products', current_locale) %></a>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.galleries') %>"><%= languageHandler('nav.gallery', current_locale) %></a>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.blogs') %>"><%= languageHandler('nav.blog', current_locale) %></a>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.contact') %>"><%= languageHandler('nav.contact', current_locale) %></a>
            </div>

            <div class="footer-col">
                <h3 class="footer-title"><%= languageHandler('nav.support', current_locale) %></h3>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.faq') %>"><%= languageHandler('nav.FAQ', current_locale) %></a>
                <a target="_self" class="footer-link" href="<%= footerContentPage('terms_of_use') %>"><%= staticContent['terms_of_use']['title'] %></a>
                <a target="_self" class="footer-link" href="<%= footerContentPage('privacy_policy') %>"><%= staticContent['privacy_policy']['title'] %></a>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.wishlist') %>"><%= languageHandler('general.wishlist', current_locale) %></a>
                <a target="_self" class="footer-link" href="<%= footerPage('slugs.cart') %>"><%= languageHandler('general.cart', current_locale) %></a>
            </div>

            <% if (DB_CONFIG["phone_1"] || DB_CONFIG["phone_2"] || DB_CONFIG["email"] || DB_CONFIG["company_street"]) { %>
                <div class="footer-col footer-col--contact">
                    <h3 class="footer-title"><%= languageHandler('nav.contact', current_locale) %></h3>
                    <% if (DB_CONFIG["company_street"]) { %>
                        <a target="_self" class="footer-contact" href="<%= footerPage('slugs.contact') %><%= (DB_CONFIG["map_lat"] && DB_CONFIG["map_long"]) ? '#location' : '' %>">
                            <span class="footer-contact__icon"><i class="fas fa-map-marker-alt"></i></span>
                            <span><%= DB_CONFIG["company_street"] %></span>
                        </a>
                    <% } %>
                    <% if (DB_CONFIG["phone_1"]) { %>
                        <a class="footer-contact" href="tel:<%= DB_CONFIG["phone_1"] %>">
                            <span class="footer-contact__icon"><i class="fas fa-phone-alt"></i></span>
                            <span><%= DB_CONFIG["phone_1"] %></span>
                        </a>
                    <% } %>
                    <% if (DB_CONFIG["phone_2"]) { %>
                        <a class="footer-contact" href="tel:<%= DB_CONFIG["phone_2"] %>">
                            <span class="footer-contact__icon"><i class="fas fa-phone-alt"></i></span>
                            <span><%= DB_CONFIG["phone_2"] %></span>
                        </a>
                    <% } %>
                    <% if (DB_CONFIG["email"]) { %>
                        <a class="footer-contact" href="mailto:<%= DB_CONFIG["email"] %>">
                            <span class="footer-contact__icon"><i class="fas fa-envelope"></i></span>
                            <span><%= DB_CONFIG["email"] %></span>
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="wrapper footer-bottom__row">
            <span><%= process.env.SITE_NAME %> &copy; <%= new Date().getFullYear() %>. <%= languageHandler('validations.rights_reserved', current_locale) %>.</span>
            <div class="footer-bottom__links">
                <a target="_self" href="<%= footerContentPage('terms_of_use') %>"><%= staticContent['terms_of_use']['title'] %></a>
                <a target="_self" href="<%= footerContentPage('privacy_policy') %>"><%= staticContent['privacy_policy']['title'] %></a>
            </div>
        </div>
    </div>
</footer>

<% if (process.env.GTAG_ID || false) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GTAG_ID %>"></script>
    <script type="text/javascript">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= process.env.GTAG_ID %>');
    </script>
<% } %>

<% if (hasRemovedCartItems) { %>
    <script type="text/javascript">
        setTimeout(function () {
            $.confirm({
                useBootstrap: false,
                boxWidth: '450px',
                title: "<%= languageHandler('general.information', current_locale) %>",
                content: "<%= languageHandler('products.modificated_cart_information', current_locale) %>",
                buttons: {
                    OK: {
                        action: function() {
                            // do nothing
                        }
                    },
                    confirm: {
                        text: "<%= languageHandler('products.check_my_cart', current_locale) %>",
                        action: function() {
                            $(".js-cart").addClass('open');
                        }
                    },
                }
            });
        }, 2000);
    </script>
<% } %>
